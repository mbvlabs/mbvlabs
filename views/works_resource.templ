			</div>
			<div class="flex items-center justify-between gap-5 border-b border-foreground py-8 font-mono text-xs uppercase tracking-[0.1em]">
				<span>End of work report</span>
				<span>MBV / Archive</span>
			</div>
		</div>
	</section>
}

type WorkShow struct {
	Item models.WorkEntity
}

func (ws WorkShow) PageFragment() string {
	return "work-show-page-fragment"
}

templ (ws WorkShow) Page() {
	{{ workData := newWorkData(ws.Item) }}
	@base(
		SetTitle(workData.Title),
		SetDescription(workData.Summary),
		SetSlug(routes.WorkShow.URL(workData.Slug)),
		SetImage(workData.CoverImageUrl),
		SetImageAlt(workData.Title),
		SetMetaType("article"),
		SetSchema(WorkShowSchema(workData)),
	) {
		@templ.Fragment(ws.PageFragment()) {
			<main id="work-show-container">
				<section class="relative overflow-hidden border-b border-zinc-200">
					<div class="pointer-events-none absolute inset-0 opacity-70" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px), linear-gradient(0deg, rgba(24,24,27,0.035) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 pb-20 pt-16 text-center md:pb-24 md:pt-20">
						<p class="text-xs font-bold text-zinc-950">WORK</p>
						<h1 class="mx-auto mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-5xl">{ workData.Title }</h1>
						if workData.Summary != "" {
							<p class="mx-auto mt-6 max-w-2xl text-sm leading-6 text-zinc-500">{ workData.Summary }</p>
						}
					</div>
				</section>
				<section class="border-b border-zinc-200 bg-white">
					<div class="mx-auto grid max-w-5xl grid-cols-1 px-6 md:grid-cols-3">
						<div class="border-b border-zinc-200 py-5 md:border-b-0 md:border-r md:pr-8">
							<p class="text-xs font-bold text-zinc-950">Client</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">
								if workData.ClientName != "" {
									{ workData.ClientName }
								} else {
									{ workData.Title }
								}
							</p>
						</div>
						<div class="border-b border-zinc-200 py-5 md:border-b-0 md:border-r md:px-8">
							<p class="text-xs font-bold text-zinc-950">Year</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">
								if !workData.CompletedAt.IsZero() {
									{ workData.CompletedAt.Format("2006") }
								} else if !workData.StartedAt.IsZero() {
									{ workData.StartedAt.Format("2006") }
								} else {
									Selected work
								}
							</p>
						</div>
						<div class="py-5 md:pl-8">
							<p class="text-xs font-bold text-zinc-950">Focus</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">
								if workData.CombinedTags() != "" {
									{ workData.CombinedTags() }
								} else {
									Product engineering
								}
							</p>
						</div>
					</div>
				</section>
				if workData.CoverImageUrl != "" {
					<section class="bg-zinc-50">
						<div class="mx-auto max-w-5xl px-6 py-10 md:py-12">
							<img src={ workData.CoverImageUrl } alt={ workData.Title } class="w-full bg-zinc-200 object-cover"/>
						</div>
					</section>
				}
				<section class="mx-auto grid max-w-5xl gap-12 px-6 py-20 md:grid-cols-[220px_1fr] md:py-24">
					<aside class="text-xs leading-5 text-zinc-500">
						<div class="flex h-10 items-center">
							if workData.ClientLogoUrl != "" {
								<img src={ workData.ClientLogoUrl } alt={ workData.ClientName } class="max-h-9 w-auto object-contain"/>
							} else {
								<div class="flex h-9 w-9 items-center justify-center bg-zinc-950 text-xs font-bold text-white">
									{ workData.Initial() }
								</div>
							}
						</div>
						<div class="mt-6 space-y-2">
							if workData.ClientName != "" {
								<p class="font-bold text-zinc-950">{ workData.ClientName }</p>
							}
							if workData.ClientIndustry != "" {
								<p>{ workData.ClientIndustry }</p>
							}
							if !workData.CompletedAt.IsZero() {
								<p>{ workData.CompletedAt.Format("January 2006") }</p>
							} else if !workData.StartedAt.IsZero() {
								<p>{ workData.StartedAt.Format("January 2006") }</p>
							}
							if workData.ClientUrl != "" {
								<a href={ workData.ClientUrl } class="inline-flex font-bold text-zinc-950 transition-colors hover:text-zinc-500">Visit site</a>
							}
						</div>
					</aside>
					<div>
						if workData.Challenge != "" {
							<section>
								<h2 class="text-base font-bold text-zinc-950">Overview</h2>
								<p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-500">{ workData.Challenge }</p>
							</section>
						} else if workData.Summary != "" {
							<section>
								<h2 class="text-base font-bold text-zinc-950">Overview</h2>
								<p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-500">{ workData.Summary }</p>
							</section>
						}
						if len(workData.Specialisms) > 0 || len(workData.Platforms) > 0 || len(workData.Technologies) > 0 {
							<section class="mt-12">
								<h2 class="text-base font-bold text-zinc-950">What I did</h2>
								<div class="mt-5 flex max-w-2xl flex-wrap gap-2">
									for _, tag := range workData.Specialisms {
										<span class="bg-zinc-100 px-3 py-1 text-xs leading-5 text-zinc-500">{ tag }</span>
									}
									for _, tag := range workData.Platforms {
										<span class="bg-zinc-100 px-3 py-1 text-xs leading-5 text-zinc-500">{ tag }</span>
									}
									for _, tag := range workData.Technologies {
										<span class="bg-zinc-100 px-3 py-1 text-xs leading-5 text-zinc-500">{ tag }</span>
									}
								</div>
							</section>
						}
						if workData.Approach != "" {
							<section class="mt-12">
								<h2 class="text-base font-bold text-zinc-950">How I approached it</h2>
								<p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-500">{ workData.Approach }</p>
							</section>
						}
						if workData.Deliverables != "" {
							<section class="mt-12">
								<h2 class="text-base font-bold text-zinc-950">Deliverables</h2>
								<p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-500">{ workData.Deliverables }</p>
							</section>
						}
						if workData.Outcome != "" {
							<section class="mt-12">
								<h2 class="text-base font-bold text-zinc-950">Outcome</h2>
								<blockquote class="mt-5 max-w-2xl border-l border-zinc-300 pl-5 text-sm leading-6 text-zinc-500">{ workData.Outcome }</blockquote>
							</section>
						}
						if workData.Content != "" {
							{{ parsedContent := MarkdownToHTML(workData.Content) }}
							<section class="mt-12 border-t border-zinc-200 pt-12">
								<article class="prose prose-sm max-w-2xl text-zinc-500 prose-headings:font-bold prose-headings:text-zinc-950 prose-a:text-zinc-950 prose-strong:text-zinc-950 prose-code:text-zinc-950 prose-pre:bg-zinc-950 prose-pre:text-zinc-100">
									@templ.Raw(parsedContent)
								</article>
							</section>
						}
					</div>
				</section>
				<section class="relative overflow-hidden bg-zinc-50">
					<div class="pointer-events-none absolute inset-0 opacity-60" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 py-20 md:py-24">
						<h2 class="text-base font-bold text-zinc-950">More work</h2>
						<div class="mt-8 border-t border-zinc-200">
							<a href={ routes.WorkIndex.URL() } class="group block max-w-3xl border-b border-zinc-200 py-8">
								<p class="text-sm leading-6 text-zinc-500">Explore selected client projects, technical leadership work, and full-time engineering experience across product delivery, architecture, backend systems, frontend applications, and operational tooling.</p>
								<h3 class="mt-5 text-base font-bold text-zinc-950 transition-colors group-hover:text-zinc-500">See all my work</h3>
							</a>
						</div>
					</div>
				</section>
			</main>
		}
	}
}

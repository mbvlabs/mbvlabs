



package views

import (
	"fmt"
	"strings"
	"time"

	"mbvlabs/models"

	"mbvlabs/router/routes"
)

type WorkData struct {
	CreatedAt      time.Time
	UpdatedAt      time.Time
	Title          string
	Slug           string
	ClientName     string
	ClientIndustry string
	ClientUrl      string
	ClientLogoUrl  string
	Summary        string
	CoverImageUrl  string
	Specialisms    []string
	Platforms      []string
	Technologies   []string
	Challenge      string
	Approach       string
	Deliverables   string
	Outcome        string
	Content        string
	StartedAt      time.Time
	CompletedAt    time.Time
	Status         string
	PublishedAt    time.Time
	IsFeatured     bool
}

func (wd WorkData) CombinedTags() string {
	all := make([]string, 0, len(wd.Specialisms)+len(wd.Platforms)+len(wd.Technologies))
	all = append(all, wd.Specialisms...)
	all = append(all, wd.Platforms...)
	all = append(all, wd.Technologies...)
	return strings.Join(all, ", ")
}

func (wd WorkData) Initial() string {
	source := strings.TrimSpace(wd.ClientName)
	if source == "" {
		source = strings.TrimSpace(wd.Title)
	}
	for _, r := range source {
		return strings.ToUpper(string(r))
	}
	return "M"
}

func newWorkData(entity models.WorkEntity) WorkData {
	return WorkData{
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
		Title:     entity.Title,
		Slug:      entity.Slug,
		ClientName: func() string {
			if !entity.ClientName.Valid {
				return ""
			}
			return entity.ClientName.String
		}(),
		ClientIndustry: func() string {
			if !entity.ClientIndustry.Valid {
				return ""
			}
			return entity.ClientIndustry.String
		}(),
		ClientUrl: func() string {
			if !entity.ClientURL.Valid {
				return ""
			}
			return entity.ClientURL.String
		}(),
		ClientLogoUrl: func() string {
			if !entity.ClientLogoURL.Valid {
				return ""
			}
			return entity.ClientLogoURL.String
		}(),
		Summary: entity.Summary,
		CoverImageUrl: func() string {
			if !entity.CoverImageURL.Valid {
				return ""
			}
			return entity.CoverImageURL.String
		}(),
		Specialisms:  entity.Specialisms,
		Platforms:    entity.Platforms,
		Technologies: entity.Technologies,
		Challenge:    entity.Challenge,
		Approach:     entity.Approach,
		Deliverables: entity.Deliverables,
		Outcome:      entity.Outcome,
		Content:      entity.Content,
		StartedAt: func() time.Time {
			if !entity.StartedAt.Valid {
				return time.Time{}
			}
			return entity.StartedAt.Time
		}(),
		CompletedAt: func() time.Time {
			if !entity.CompletedAt.Valid {
				return time.Time{}
			}
			return entity.CompletedAt.Time
		}(),
		Status: entity.Status.HumanString(),
		PublishedAt: func() time.Time {
			if !entity.PublishedAt.Valid {
				return time.Time{}
			}
			return entity.PublishedAt.Time
		}(),
		IsFeatured: entity.IsFeatured,
	}
}

type WorkIndex struct {
	Items []models.WorkEntity
}

func (wi WorkIndex) PageFragment() string {
	return "work-index-page-fragment"
}

templ (wi WorkIndex) Page() {
	@themedBase(
		"cobalt-grid",
		SetTitle("Client Work and Software Engineering Case Studies"),
		SetDescription("Client work and full-time engineering experience from MBV Labs, a fractional tech lead for founders and lean teams."),
		SetSlug(routes.WorkIndex.URL()),
		SetSchema(WorkIndexSchema(wi.Items)),
	) {
		@templ.Fragment(wi.PageFragment()) {
			<main id="work-index-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
						@Breadcrumbs([]SchemaBreadcrumb{
							{Name: "Home", Path: routes.HomePage.URL()},
							{Name: "Work", Path: routes.WorkIndex.URL()},
						})
						<h1 class="cobalt-display mt-8 max-w-6xl">Proven software for real product and operations problems.</h1>
						<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">I work as a fractional tech lead for founders and lean teams who need senior engineering judgment, hands-on implementation, and software that can keep moving after launch.</p>
						<div class="mt-16 grid gap-5 border-t border-foreground pt-5 font-mono text-[11px] uppercase tracking-[0.12em] sm:grid-cols-3">
							<div><p class="font-medium">Record</p><p class="mt-1 opacity-65">Client systems</p></div>
							<div><p class="font-medium">Practice</p><p class="mt-1 opacity-65">Plan / Build / Improve</p></div>
							<div><p class="font-medium">Archive</p><p class="mt-1 opacity-65">2016 / Present</p></div>
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
						<div>
							<p class="font-mono text-xs uppercase tracking-[0.18em]">Selected engagements</p>
							<h2 class="cobalt-section-title mt-4">Client work.</h2>
						</div>
						<p class="text-xs font-semibold uppercase tracking-[0.18em]">Production systems / Case files</p>
					</div>
					if len(wi.Items) == 0 {
						<div class="border-b border-border py-12">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">No work is published yet.</p>
						</div>
					} else {
						<div>
							for index, work := range wi.Items {
								{{ workData := newWorkData(work) }}
								<a href={ routes.WorkShow.URL(work.Slug) } class="group grid gap-6 border-b border-border py-12 transition-colors hover:bg-secondary/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring md:grid-cols-[4rem_minmax(10rem,0.7fr)_minmax(0,1.3fr)_7rem] md:items-start md:px-3">
									<p class="font-mono text-sm tracking-[0.08em]">{ fmt.Sprintf("%02d.", index+1) }</p>
									<div>
										<div class="flex min-h-10 items-center">
											if workData.ClientLogoUrl != "" {
												<img src={ workData.ClientLogoUrl } alt={ workData.ClientName } class="max-h-9 w-auto object-contain"/>
											} else {
												<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono text-xs font-medium">{ workData.Initial() }</span>
											}
										</div>
										<div class="mt-5 text-xs uppercase leading-5 tracking-[0.12em]">
											if workData.ClientName != "" {
												<p class="font-semibold">{ workData.ClientName }</p>
											}
											if len(workData.Specialisms) > 0 {
												<p class="mt-1 opacity-65">{ workData.Specialisms[0] }</p>
											}
											if !workData.CompletedAt.IsZero() {
												<p class="mt-1 font-mono opacity-65">{ workData.CompletedAt.Format("January 2006") }</p>
											} else if !workData.StartedAt.IsZero() {
												<p class="mt-1 font-mono opacity-65">{ workData.StartedAt.Format("January 2006") }</p>
											}
										</div>
									</div>
									<div>
										<h3 class="cobalt-row-title">{ workData.Title }</h3>
										<p class="mt-4 max-w-2xl text-sm leading-6">{ workData.Summary }</p>
										if workData.Outcome != "" {
											<blockquote class="mt-7 max-w-2xl border-l border-foreground pl-5 text-sm leading-6 opacity-75">{ workData.Outcome }</blockquote>
										}
									</div>
									<span class="text-xs font-semibold uppercase tracking-[0.12em] transition-transform group-hover:translate-x-1 md:text-right">View work →</span>
								</a>
							}
						</div>
					}
				</section>

				<section class="flex min-h-[60svh] items-center border-y border-foreground">
					<div class="container mx-auto px-6 py-24 md:px-8 md:py-28">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">The founder brief / 01</p>
						<blockquote class="cobalt-quote mt-10 max-w-6xl">&ldquo;I need technical help, but I do not want to hire full-time yet.&rdquo;</blockquote>
						<div class="mt-14 flex items-center justify-between gap-5 border-t border-foreground pt-5 font-mono text-xs uppercase tracking-[0.12em]">
							<p class="font-medium">MBV Labs</p>
							<p class="opacity-65">Senior help / Flexible model</p>
						</div>
					</div>
				</section>

				if len(wi.Items) > 0 {
					<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
						<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
							<h2 class="cobalt-section-title">People I have helped.</h2>
							<p class="text-xs font-semibold uppercase tracking-[0.18em]">Client ledger / Published work</p>
						</div>
						<div class="grid sm:grid-cols-2 lg:grid-cols-4">
							for index, work := range wi.Items {
								{{ workData := newWorkData(work) }}
								<div class="flex min-h-40 flex-col justify-between border-b border-border p-6 sm:odd:border-r lg:border-r lg:nth-[4n]:border-r-0">
									<p class="font-mono text-xs tracking-[0.08em]">{ fmt.Sprintf("%02d.", index+1) }</p>
									<div class="mt-8">
										if workData.ClientLogoUrl != "" {
											<img src={ workData.ClientLogoUrl } alt={ workData.ClientName } class="max-h-8 w-auto object-contain"/>
										} else {
											<div class="flex items-center gap-3">
												<span class="inline-flex h-8 w-8 shrink-0 items-center justify-center border border-foreground font-mono text-xs">{ workData.Initial() }</span>
												<p class="font-heading text-2xl leading-none">
													if workData.ClientName != "" {
														{ workData.ClientName }
													} else {
														{ workData.Title }
													}
												</p>
											</div>
										}
									</div>
								</div>
							}
						</div>
					</section>
				}

				@workExperienceSection()
			</main>
		}
	}
}

templ workExperienceSection() {
	<section class="border-t border-foreground">
		<div class="container mx-auto px-6 py-20 md:px-8 md:py-24">
			<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.18em]">Employment archive</p>
					<h2 class="cobalt-section-title mt-4">Experience history.</h2>
				</div>
				<p class="text-xs font-semibold uppercase tracking-[0.18em]">Six records / 2016-2022</p>
			</div>
			<div>
				<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(11rem,0.7fr)_minmax(0,1.3fr)] md:px-3">
					<p class="font-mono text-sm tracking-[0.08em]">01.</p>
					<aside class="text-xs uppercase leading-5 tracking-[0.12em]">
						<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono">P</span>
						<p class="mt-5 font-semibold">Parkeringskompagniet</p>
						<p class="mt-1 font-mono opacity-65">Nov 2020 - Mar 2022</p>
						<p class="mt-1 opacity-65">1 yr 5 mos</p>
					</aside>
					<div class="space-y-10">
						<div>
							<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
								<h3 class="cobalt-row-title">Technical Lead</h3>
								<p class="font-mono text-xs uppercase tracking-[0.12em]">Full-time</p>
							</div>
							<p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] opacity-65">Jul 2021 - Mar 2022 - 9 mos</p>
							<p class="mt-6 max-w-3xl text-sm leading-6">My work focused on software architecture, team building, and code quality. I worked primarily with Go while restructuring the backend from a legacy Java codebase, and React with TypeScript for the customer-facing dashboard. I also architected microservices for handling camera events so parking-lot customers could get reliable real-time information.</p>
							<p class="mt-4 max-w-3xl text-sm leading-6">I hired and built a remote team of junior engineers, with a particular focus on teaching domain-driven design, Go, React, and TypeScript.</p>
							<p class="mt-6 font-mono text-xs uppercase leading-5 tracking-[0.1em]"><span class="font-medium">Focus /</span> software architecture, Go, React, TypeScript, DevOps, team building</p>
						</div>
						<div class="border-t border-border pt-10">
							<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
								<h3 class="cobalt-row-title">External Consultant</h3>
								<p class="font-mono text-xs uppercase tracking-[0.12em]">Freelance</p>
							</div>
							<p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] opacity-65">Nov 2020 - Aug 2021 - 10 mos</p>
							<p class="mt-6 max-w-3xl text-sm leading-6">I consulted on software architecture and design, implemented CI/CD flows, and introduced React, TypeScript, and Go into the company's codebase and engineering practices.</p>
							<p class="mt-6 font-mono text-xs uppercase leading-5 tracking-[0.1em]"><span class="font-medium">Focus /</span> architecture, implementation, CI/CD, Go, React, TypeScript</p>
						</div>
					</div>
				</article>

				<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(11rem,0.7fr)_minmax(0,1.3fr)] md:px-3">
					<p class="font-mono text-sm tracking-[0.08em]">02.</p>
					<aside class="text-xs uppercase leading-5 tracking-[0.12em]">
						<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono">E</span>
						<p class="mt-5 font-semibold">everphone</p>
						<p class="mt-1 opacity-65">Berlin, Germany</p>
						<p class="mt-1 font-mono opacity-65">Feb 2021 - Aug 2021</p>
					</aside>
					<div>
						<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
							<h3 class="cobalt-row-title">Full Stack Engineer</h3>
							<p class="font-mono text-xs uppercase tracking-[0.12em]">Full-time</p>
						</div>
						<p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] opacity-65">7 mos</p>
						<p class="mt-6 max-w-3xl text-sm leading-6">I worked on improving code quality for the company's React dashboard, particularly by using TypeScript more deliberately. I also worked on moving the API from PHP to Go and from REST to GraphQL, while improving local DevOps through containerization.</p>
						<p class="mt-6 font-mono text-xs uppercase leading-5 tracking-[0.1em]"><span class="font-medium">Focus /</span> React, TypeScript, Go, GraphQL, DevOps, test-driven development</p>
					</div>
				</article>

				<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(11rem,0.7fr)_minmax(0,1.3fr)] md:px-3">
					<p class="font-mono text-sm tracking-[0.08em]">03.</p>
					<aside class="text-xs uppercase leading-5 tracking-[0.12em]">
						<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono">L</span>
						<p class="mt-5 font-semibold">Legal Monster</p>
						<p class="mt-1 font-mono opacity-65">Sep 2019 - Dec 2020</p>
						<p class="mt-1 opacity-65">1 yr 4 mos</p>
					</aside>
					<div>
						<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
							<h3 class="cobalt-row-title">Full Stack Engineer</h3>
							<p class="font-mono text-xs uppercase tracking-[0.12em]">Full-time</p>
						</div>
						<p class="mt-6 max-w-3xl text-sm leading-6">I worked primarily with React, TypeScript, and Ruby on Rails. I was involved in the initial stages of product discovery and product building while the company was working toward product-market fit.</p>
						<p class="mt-6 font-mono text-xs uppercase leading-5 tracking-[0.1em]"><span class="font-medium">Focus /</span> React, TypeScript, Ruby on Rails, product discovery, DevOps, test-driven development</p>
					</div>
				</article>

				<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(11rem,0.7fr)_minmax(0,1.3fr)] md:px-3">
					<p class="font-mono text-sm tracking-[0.08em]">04.</p>
					<aside class="text-xs uppercase leading-5 tracking-[0.12em]">
						<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono">H</span>
						<p class="mt-5 font-semibold">HS MØLLER APS</p>
						<p class="mt-1 font-mono opacity-65">Jun 2018 - Aug 2019</p>
						<p class="mt-1 opacity-65">1 yr 3 mos</p>
					</aside>
					<div>
						<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
							<h3 class="cobalt-row-title">Full Stack Engineer</h3>
							<p class="font-mono text-xs uppercase tracking-[0.12em]">Full-time</p>

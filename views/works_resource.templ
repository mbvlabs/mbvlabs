						<p class="mt-6 max-w-3xl text-sm leading-6">I worked on smaller React projects, primarily with a designer to improve clients' online presence and UX/UI. I also built internal Go tools to improve DevOps workflows.</p>
						<p class="mt-6 font-mono text-xs uppercase leading-5 tracking-[0.1em]"><span class="font-medium">Focus /</span> React, TypeScript, Go, UX/UI, DevOps</p>
					</div>
				</article>

				<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(11rem,0.7fr)_minmax(0,1.3fr)] md:px-3">
					<p class="font-mono text-sm tracking-[0.08em]">05.</p>
					<aside class="text-xs uppercase leading-5 tracking-[0.12em]">
						<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono">E</span>
						<p class="mt-5 font-semibold">Easy-skat ApS</p>
						<p class="mt-1 opacity-65">Copenhagen, Denmark</p>
						<p class="mt-1 font-mono opacity-65">Apr 2018 - Jun 2018</p>
					</aside>
					<div>
						<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
							<h3 class="cobalt-row-title">Softwareudvikler</h3>
							<p class="font-mono text-xs uppercase tracking-[0.12em]">Internship</p>
						</div>
						<p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] opacity-65">3 mos</p>
						<p class="mt-6 max-w-3xl text-sm leading-6">I worked on smaller React projects, primarily with a designer to improve clients' online presence and UX/UI.</p>
						<p class="mt-6 font-mono text-xs uppercase leading-5 tracking-[0.1em]"><span class="font-medium">Focus /</span> React, TypeScript, problem solving, UX/UI</p>
					</div>
				</article>

				<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(11rem,0.7fr)_minmax(0,1.3fr)] md:px-3">
					<p class="font-mono text-sm tracking-[0.08em]">06.</p>
					<aside class="text-xs uppercase leading-5 tracking-[0.12em]">
						<span class="inline-flex h-9 w-9 items-center justify-center border border-foreground font-mono">E</span>
						<p class="mt-5 font-semibold">Ennova</p>
						<p class="mt-1 opacity-65">Copenhagen Metropolitan Area</p>
						<p class="mt-1 font-mono opacity-65">Aug 2016 - Dec 2016</p>
					</aside>
					<div>
						<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-4">
							<h3 class="cobalt-row-title">Praktikant</h3>
							<p class="font-mono text-xs uppercase tracking-[0.12em]">Internship</p>
						</div>
						<p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] opacity-65">5 mos</p>
					</div>
				</article>
			</div>
			<div class="flex items-center justify-between gap-5 border-b border-foreground py-8 font-mono text-xs uppercase tracking-[0.1em]">
				<span>End of work report</span>
				<span>MBV / Archive</span>
			</div>
		</div>
	</section>
}

type WorkShow struct {
	Item models.WorkEntity
}

func (ws WorkShow) PageFragment() string {
	return "work-show-page-fragment"
}

templ (ws WorkShow) Page() {
	{{ workData := newWorkData(ws.Item) }}
	@themedBase(
		"cobalt-grid",
		SetTitle(workData.Title),
		SetDescription(workData.Summary),
		SetSlug(routes.WorkShow.URL(workData.Slug)),
		SetImage(workData.CoverImageUrl),
		SetImageAlt(workData.Title),
		SetMetaType("article"),
		SetSchema(WorkShowSchema(workData)),
	) {
		@templ.Fragment(ws.PageFragment()) {
			<main id="work-show-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
						@Breadcrumbs([]SchemaBreadcrumb{
							{Name: "Home", Path: routes.HomePage.URL()},
							{Name: "Work", Path: routes.WorkIndex.URL()},
							{Name: "Client work", Path: routes.WorkShow.URL(workData.Slug)},
						})
						<h1 class="cobalt-display mt-8 max-w-6xl">{ workData.Title }</h1>
						if workData.Summary != "" {
							<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">{ workData.Summary }</p>
						}
					</div>
				</section>

				<section class="border-b border-foreground">
					<div class="container mx-auto grid px-6 md:grid-cols-3 md:px-8">
						<div class="border-b border-border py-6 md:border-b-0 md:border-r md:pr-8">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">01 / Client</p>
							<p class="mt-3 text-sm leading-6">
								if workData.ClientName != "" {
									{ workData.ClientName }
								} else {
									{ workData.Title }
								}
							</p>
						</div>
						<div class="border-b border-border py-6 md:border-b-0 md:border-r md:px-8">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">02 / Year</p>
							<p class="mt-3 text-sm leading-6">
								if !workData.CompletedAt.IsZero() {
									{ workData.CompletedAt.Format("2006") }
								} else if !workData.StartedAt.IsZero() {
									{ workData.StartedAt.Format("2006") }
								} else {
									Selected work
								}
							</p>
						</div>
						<div class="py-6 md:pl-8">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">03 / Focus</p>
							<p class="mt-3 text-sm leading-6">
								if workData.CombinedTags() != "" {
									{ workData.CombinedTags() }
								} else {
									Product engineering
								}
							</p>
						</div>
					</div>
				</section>

				if workData.CoverImageUrl != "" {
					<section class="border-b border-foreground bg-secondary/45">
						<div class="container mx-auto px-6 py-10 md:px-8 md:py-14">
							<img src={ workData.CoverImageUrl } alt={ workData.Title } class="w-full border border-foreground bg-muted object-cover"/>
						</div>
					</section>
				}

				<section class="container mx-auto grid gap-16 px-6 py-20 md:px-8 md:py-24 lg:grid-cols-[minmax(12rem,0.55fr)_minmax(0,1.45fr)] lg:gap-24">
					<aside class="text-xs uppercase leading-5 tracking-[0.12em] lg:sticky lg:top-24 lg:self-start">
						<div class="flex min-h-10 items-center">
							if workData.ClientLogoUrl != "" {
								<img src={ workData.ClientLogoUrl } alt={ workData.ClientName } class="max-h-10 w-auto object-contain"/>
							} else {
								<span class="inline-flex h-10 w-10 items-center justify-center border border-foreground font-mono">{ workData.Initial() }</span>
							}
						</div>
						<div class="mt-8 border-t border-foreground pt-5">
							<p class="font-mono opacity-65">Client record</p>
							if workData.ClientName != "" {
								<p class="mt-4 font-semibold">{ workData.ClientName }</p>
							}
							if workData.ClientIndustry != "" {
								<p class="mt-2 opacity-65">{ workData.ClientIndustry }</p>
							}
							if !workData.CompletedAt.IsZero() {
								<p class="mt-2 font-mono opacity-65">{ workData.CompletedAt.Format("January 2006") }</p>
							} else if !workData.StartedAt.IsZero() {
								<p class="mt-2 font-mono opacity-65">{ workData.StartedAt.Format("January 2006") }</p>
							}
							if workData.ClientUrl != "" {
								<a href={ workData.ClientUrl } data-palantir-event="work-client-site" class="mt-6 inline-flex min-h-11 items-center border border-foreground px-4 py-2 font-semibold transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Visit site →</a>
							}
						</div>
					</aside>

					<div>
						if workData.Challenge != "" {
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">01 / Brief</p>
								<h2 class="cobalt-row-title mt-5">Overview</h2>
								<p class="mt-6 max-w-3xl text-base leading-7">{ workData.Challenge }</p>
							</section>
						} else if workData.Summary != "" {
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">01 / Brief</p>
								<h2 class="cobalt-row-title mt-5">Overview</h2>
								<p class="mt-6 max-w-3xl text-base leading-7">{ workData.Summary }</p>
							</section>
						}
						if len(workData.Specialisms) > 0 || len(workData.Platforms) > 0 || len(workData.Technologies) > 0 {
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">02 / Scope</p>
								<h2 class="cobalt-row-title mt-5">What I did</h2>
								<div class="mt-7 flex max-w-3xl flex-wrap gap-2">
									for _, tag := range workData.Specialisms {
										<span class="border border-border px-3 py-2 font-mono text-xs uppercase leading-5 tracking-[0.08em]">{ tag }</span>
									}
									for _, tag := range workData.Platforms {
										<span class="border border-border px-3 py-2 font-mono text-xs uppercase leading-5 tracking-[0.08em]">{ tag }</span>
									}
									for _, tag := range workData.Technologies {
										<span class="border border-border px-3 py-2 font-mono text-xs uppercase leading-5 tracking-[0.08em]">{ tag }</span>
									}
								</div>
							</section>
						}
						if workData.Approach != "" {
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">03 / Method</p>
								<h2 class="cobalt-row-title mt-5">How I approached it</h2>
								<p class="mt-6 max-w-3xl text-base leading-7">{ workData.Approach }</p>
							</section>
						}
						if workData.Deliverables != "" {
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">04 / Output</p>
								<h2 class="cobalt-row-title mt-5">Deliverables</h2>
								<p class="mt-6 max-w-3xl text-base leading-7">{ workData.Deliverables }</p>
							</section>
						}
						if workData.Outcome != "" {
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">05 / Result</p>
								<h2 class="cobalt-row-title mt-5">Outcome</h2>
								<blockquote class="mt-7 max-w-3xl border-l border-foreground pl-6 font-heading text-3xl leading-tight md:text-4xl">{ workData.Outcome }</blockquote>
							</section>
						}
						if workData.Content != "" {
							{{ parsedContent := MarkdownToHTML(workData.Content) }}
							<section class="border-t border-foreground py-10">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">06 / Field notes</p>
								<h2 class="cobalt-row-title mt-5">Project notes</h2>
								<article class="prose prose-sm mt-8 max-w-3xl text-foreground prose-headings:font-heading prose-headings:font-normal prose-headings:text-foreground prose-p:text-foreground prose-a:text-foreground prose-a:underline prose-strong:text-foreground prose-code:text-foreground prose-li:text-foreground prose-hr:border-foreground prose-img:rounded-none prose-pre:rounded-none prose-pre:border prose-pre:border-foreground prose-pre:bg-primary prose-pre:text-primary-foreground prose-blockquote:border-foreground prose-blockquote:text-foreground">
									@templ.Raw(parsedContent)
								</article>
							</section>
						}
					</div>
				</section>

				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-24">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Archive / Continue reading</p>
						<h2 class="cobalt-section-title mt-5">More work.</h2>
						<a href={ routes.WorkIndex.URL() } class="group mt-10 grid gap-6 border-y border-border py-10 transition-colors hover:bg-secondary/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring md:grid-cols-[minmax(0,1fr)_8rem] md:items-end md:px-3">
							<div>
								<p class="max-w-3xl text-sm leading-6">Explore selected client projects, technical leadership work, and full-time engineering experience across product delivery, architecture, backend systems, frontend applications, and operational tooling.</p>
								<h3 class="cobalt-row-title mt-6">See all my work</h3>
							</div>
							<span class="text-xs font-semibold uppercase tracking-[0.12em] transition-transform group-hover:translate-x-1 md:text-right">Open index →</span>
						</a>
					</div>
				</section>
			</main>
		}
	}
}

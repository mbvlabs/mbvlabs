package views

import "mbvlabs/router/routes"

templ AboutMe() {
	@themedBase(
		"cobalt-grid",
		SetTitle("About"),
		SetDescription("MBV Labs is a fractional tech lead and engineering studio for founders and lean teams that need senior judgment and hands-on execution."),
		SetSlug(routes.AboutMe.URL()),
		SetSchema(PageSchema("AboutPage", []SchemaBreadcrumb{
			{Name: "Home", Path: routes.HomePage.URL()},
			{Name: "About", Path: routes.AboutMe.URL()},
		})),
	) {
		<main id="about-container" class="overflow-hidden bg-background font-sans text-foreground">
			<section class="border-y border-foreground">
				<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
					<p class="font-mono text-xs uppercase tracking-[0.18em]">Field report / About MBV Labs</p>
					<h1 class="cobalt-display mt-8 max-w-6xl">A fractional tech lead who still ships.</h1>
					<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">MBV Labs helps founders and lean teams turn ambiguous software goals into production web apps, internal tools, automation, and developer infrastructure without hiring a full-time technical leader too early.</p>
					<div class="mt-16 grid gap-5 border-t border-foreground pt-5 font-mono text-[11px] uppercase tracking-[0.12em] sm:grid-cols-3">
						<div><p class="font-medium">Role</p><p class="mt-1 opacity-65">Fractional tech lead</p></div>
						<div><p class="font-medium">Practice</p><p class="mt-1 opacity-65">Plan / Build / Improve</p></div>
						<div><p class="font-medium">Model</p><p class="mt-1 opacity-65">Senior / Hands-on</p></div>
					</div>
				</div>
			</section>

			<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
				<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
					<h2 class="cobalt-section-title">What I do.</h2>
					<p class="text-xs font-semibold uppercase tracking-[0.18em]">Delivery / Three fields</p>
				</div>
				<div class="grid md:grid-cols-3">
					<div class="border-b border-border py-10 md:border-r md:pr-8">
						<p class="font-mono text-xs tracking-[0.08em]">01.</p>
						<h3 class="cobalt-row-title mt-6">Shape the work</h3>
						<p class="mt-4 text-sm leading-6">Turn fuzzy product or technical goals into scope, architecture, delivery tradeoffs, and a practical build plan.</p>
					</div>
					<div class="border-b border-border py-10 md:border-r md:px-8">
						<p class="font-mono text-xs tracking-[0.08em]">02.</p>
						<h3 class="cobalt-row-title mt-6">Build the system</h3>
						<p class="mt-4 text-sm leading-6">Ship full-stack features, backend systems, internal tools, integrations, automations, and developer infrastructure.</p>
					</div>
					<div class="border-b border-border py-10 md:pl-8">
						<p class="font-mono text-xs tracking-[0.08em]">03.</p>
						<h3 class="cobalt-row-title mt-6">Leave it maintainable</h3>
						<p class="mt-4 text-sm leading-6">Make choices that fit the team's future operating reality, not just the fastest path to a demo.</p>
					</div>
				</div>
			</section>

			<section class="flex min-h-[60svh] items-center border-y border-foreground">
				<div class="container mx-auto px-6 py-24 md:px-8 md:py-28">
					<p class="font-mono text-xs uppercase tracking-[0.18em]">Founder brief / 01</p>
					<blockquote class="cobalt-quote mt-10 max-w-6xl">&ldquo;I need technical help, but I do not want to hire full-time yet.&rdquo;</blockquote>
					<div class="mt-14 flex items-center justify-between gap-5 border-t border-foreground pt-5 font-mono text-xs uppercase tracking-[0.12em]">
						<p class="font-medium">MBV Labs</p>
						<p class="opacity-65">Senior help / Flexible model</p>
					</div>
				</div>
			</section>

			<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
				<div class="grid gap-12 lg:grid-cols-[0.65fr_1.35fr] lg:gap-24">
					<div>
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Audience / 01</p>
						<h2 class="cobalt-section-title mt-5">Who it is for.</h2>
					</div>
					<div class="border-t border-foreground pt-7">
						<h3 class="cobalt-row-title max-w-3xl">Founders and lean teams with important software to ship.</h3>
						<p class="mt-6 max-w-3xl text-base leading-7">The fit is focused, high-leverage engineering work where senior judgment matters more than large headcount: MVPs, product buildouts, internal operations tools, integrations, codebase modernization, and technical experiments.</p>
						<div class="mt-10 grid border-y border-border md:grid-cols-2">
							<div class="border-b border-border py-7 md:border-b-0 md:border-r md:pr-8">
								<p class="font-mono text-xs uppercase tracking-[0.12em]">When teams call</p>
								<p class="mt-4 text-sm leading-6">Progress is too slow, the existing team lacks bandwidth, a system is getting harder to change, or a product bottleneck needs software to remove it.</p>
							</div>
							<div class="py-7 md:pl-8">
								<p class="font-mono text-xs uppercase tracking-[0.12em]">What they get</p>
								<p class="mt-4 text-sm leading-6">Direct access to senior engineering judgment, hands-on implementation, clear communication, and software that can keep moving after launch.</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="border-y border-foreground">
				<div class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<p class="font-mono text-xs uppercase tracking-[0.18em]">Working style / Direct ownership</p>
					<h2 class="cobalt-section-title mt-5 max-w-5xl">Pragmatic software, clear tradeoffs, direct senior ownership.</h2>
					<p class="mt-7 max-w-3xl text-base leading-7">MBV Labs is not positioned as cheap implementation labor or a bloated agency process. It is a focused technical partner for teams that need someone who can understand the business context, make practical technical decisions, communicate clearly, and personally ship durable software.</p>
					<a href={ routes.ProjectInquiryIndex.URL() } class="mt-9 inline-flex min-h-11 items-center border border-primary bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Start an inquiry</a>
				</div>
			</section>
		</main>
	}
}

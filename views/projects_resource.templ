package views

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"mbvlabs/models"

	"mbvlabs/router/routes"
)

type ProjectData struct {
	CreatedAt     time.Time
	UpdatedAt     time.Time
	Name          string
	Slug          string
	Tagline       string
	Description   string
	ProjectType   string
	RepositoryURL string
	LiveURL       string
	ImageURL      string
	Technologies  json.RawMessage
	StartedAt     time.Time
	LaunchedAt    time.Time
	PublishedAt   time.Time
	IsFeatured    bool
}

func newProjectData(entity models.ProjectEntity) ProjectData {
	return ProjectData{
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
		Name:      entity.Name,
		Slug:      entity.Slug,
		Tagline:   entity.Tagline,
		Description: func() string {
			if !entity.Description.Valid {
				return ""
			}
			return entity.Description.String
		}(),
		ProjectType: entity.ProjectType,
		RepositoryURL: func() string {
			if !entity.RepositoryURL.Valid {
				return ""
			}
			return entity.RepositoryURL.String
		}(),
		LiveURL: func() string {
			if !entity.LiveURL.Valid {
				return ""
			}
			return entity.LiveURL.String
		}(),
		ImageURL: func() string {
			if !entity.ImageURL.Valid {
				return ""
			}
			return entity.ImageURL.String
		}(),
		Technologies: entity.Technologies,
		StartedAt: func() time.Time {
			if !entity.StartedAt.Valid {
				return time.Time{}
			}
			return entity.StartedAt.Time
		}(),
		LaunchedAt: func() time.Time {
			if !entity.LaunchedAt.Valid {
				return time.Time{}
			}
			return entity.LaunchedAt.Time
		}(),
		PublishedAt: func() time.Time {
			if !entity.PublishedAt.Valid {
				return time.Time{}
			}
			return entity.PublishedAt.Time
		}(),
		IsFeatured: entity.IsFeatured,
	}
}

func (pd ProjectData) Initial() string {
	source := strings.TrimSpace(pd.Name)
	for _, r := range source {
		return strings.ToUpper(string(r))
	}
	return "M"
}

func (pd ProjectData) ProjectTypeLabel() string {
	labels := map[string]string{
		"web-app":     "Web app",
		"website":     "Website",
		"automation":  "Automation",
		"integration": "Integration",
		"consulting":  "Consulting",
		"framework":   "Framework",
	}
	if label, ok := labels[pd.ProjectType]; ok {
		return label
	}
	return strings.TrimSpace(pd.ProjectType)
}

func (pd ProjectData) SourceLabel() string {
	if pd.RepositoryURL != "" {
		return "Open source"
	}
	return "Closed-sourced"
}

func (pd ProjectData) YearLabel() string {
	if !pd.LaunchedAt.IsZero() {
		return pd.LaunchedAt.Format("2006")
	}
	if !pd.StartedAt.IsZero() {
		return pd.StartedAt.Format("2006")
	}
	return "Built by MBV Labs"
}

func (pd ProjectData) DateLabel() string {
	if !pd.LaunchedAt.IsZero() {
		return pd.LaunchedAt.Format("January 2006")
	}
	if !pd.StartedAt.IsZero() {
		return pd.StartedAt.Format("January 2006")
	}
	return ""
}

func (pd ProjectData) TechnologiesList() []string {
	var technologies []string
	if err := json.Unmarshal(pd.Technologies, &technologies); err != nil {
		return nil
	}

	compactTechnologies := technologies[:0]
	for _, technology := range technologies {
		technology = strings.TrimSpace(technology)
		if technology != "" {
			compactTechnologies = append(compactTechnologies, technology)
		}
	}

	return compactTechnologies
}

type ProjectIndex struct {
	Items []models.ProjectEntity
}

func (pi ProjectIndex) PageFragment() string {
	return "project-index-page-fragment"
}

templ (pi ProjectIndex) Page() {
	@themedBase(
		"cobalt-grid",
		SetTitle("Projects"),
		SetDescription("Open source and commercial projects and products built in and through MBV Labs."),
		SetSlug(routes.ProjectIndex.URL()),
		SetSchema(ProjectIndexSchema(pi.Items)),
	) {
		@templ.Fragment(pi.PageFragment()) {
			<main id="project-index-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Field report / Project index</p>
						<h1 class="cobalt-display mt-8 max-w-6xl">Products and tools built in and through MBV Labs.</h1>
						<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">A mix of open source software, commercial products, internal tools, automations, and experiments shaped by practical product engineering.</p>
						<div class="mt-16 grid gap-5 border-t border-foreground pt-5 font-mono text-[11px] uppercase tracking-[0.12em] sm:grid-cols-3">
							<div><p class="font-medium">Collection</p><p class="mt-1 opacity-65">Independent builds</p></div>
							<div><p class="font-medium">Availability</p><p class="mt-1 opacity-65">Open / Closed source</p></div>
							<div><p class="font-medium">Practice</p><p class="mt-1 opacity-65">Products / Tools / Systems</p></div>
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
						<div>
							<p class="font-mono text-xs uppercase tracking-[0.18em]">Product archive</p>
							<h2 class="cobalt-section-title mt-4">Built by MBV Labs.</h2>
						</div>
						<p class="text-xs font-semibold uppercase tracking-[0.18em]">Selected projects / Current index</p>
					</div>
					if len(pi.Items) == 0 {
						<div class="border-b border-border py-12">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">No projects are listed yet.</p>
						</div>
					} else {
						<div>
							for index, project := range pi.Items {
								{{ projectData := newProjectData(project) }}
								{{ technologies := projectData.TechnologiesList() }}
								<article class="grid gap-6 border-b border-border py-12 md:grid-cols-[4rem_minmax(10rem,0.65fr)_minmax(0,1.25fr)_8rem] md:items-start md:px-3">
									<p class="font-mono text-sm tracking-[0.08em]">{ fmt.Sprintf("%02d.", index+1) }</p>
									<div>
										<div class="flex min-h-10 items-center">
											if projectData.ImageURL != "" {
												<img src={ projectData.ImageURL } alt={ projectData.Name } class="max-h-10 w-auto object-contain"/>
											} else {
												<span class="inline-flex h-10 w-10 items-center justify-center border border-foreground font-mono text-xs">{ projectData.Initial() }</span>
											}
										</div>
										<div class="mt-5 text-xs uppercase leading-5 tracking-[0.12em]">
											<p class="font-semibold">{ projectData.ProjectTypeLabel() }</p>
											<p class="mt-1 opacity-65">{ projectData.SourceLabel() }</p>
											if projectData.DateLabel() != "" {
												<p class="mt-1 font-mono opacity-65">{ projectData.DateLabel() }</p>
											} else {
												<p class="mt-1 font-mono opacity-65">{ projectData.YearLabel() }</p>
											}
										</div>
									</div>
									<div>
										<a href={ routes.ProjectShow.URL(projectData.Slug) } class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
											<h3 class="cobalt-row-title transition-opacity group-hover:opacity-65">{ projectData.Name }</h3>
										</a>
										<p class="mt-4 max-w-2xl text-sm leading-6">{ projectData.Tagline }</p>
										if len(technologies) > 0 {
											<div class="mt-6 flex max-w-2xl flex-wrap gap-2">
												for _, technology := range technologies {
													<span class="border border-border px-3 py-2 font-mono text-xs uppercase leading-5 tracking-[0.08em]">{ technology }</span>
												}
											</div>
										}
									</div>
									<div class="flex flex-col items-start gap-3 md:items-stretch">
										<a href={ routes.ProjectShow.URL(projectData.Slug) } class="inline-flex min-h-11 items-center justify-center border border-primary bg-primary px-4 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View project</a>
										if projectData.LiveURL != "" {
											<a href={ projectData.LiveURL } class="inline-flex min-h-11 items-center justify-center border border-foreground px-4 py-3 text-xs font-semibold uppercase tracking-[0.12em] transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Visit site →</a>
										}
									</div>
								</article>
							}
						</div>
					}
				</section>

				if len(pi.Items) > 0 {
					<section class="flex min-h-[60svh] items-center border-y border-foreground">
						<div class="container mx-auto px-6 py-24 md:px-8 md:py-28">
							<p class="font-mono text-xs uppercase tracking-[0.18em]">Product note / 01</p>
							<blockquote class="cobalt-quote mt-10 max-w-6xl">Some systems become products. Some stay private because the business logic is the product.</blockquote>
							<div class="mt-14 flex items-center justify-between gap-5 border-t border-foreground pt-5 font-mono text-xs uppercase tracking-[0.12em]">
								<p class="font-medium">MBV Labs</p>
								<p class="opacity-65">Build / Operate / Learn</p>
							</div>
						</div>
					</section>
				}
			</main>
		}
	}
}

type ProjectShow struct {
	Item models.ProjectEntity
}

func (ps ProjectShow) PageFragment() string {
	return "project-show-page-fragment"
}

templ (ps ProjectShow) Page() {
	{{ projectData := newProjectData(ps.Item) }}
	{{ technologies := projectData.TechnologiesList() }}
	@base(
		SetTitle(projectData.Name),
		SetDescription(projectData.Tagline),
		SetSlug(routes.ProjectShow.URL(projectData.Slug)),
		SetImage(projectData.ImageURL),
		SetImageAlt(projectData.Name),
		SetSchema(ProjectShowSchema(projectData, technologies)),
	) {
		@templ.Fragment(ps.PageFragment()) {
			<main id="project-show-container">
				<section class="relative overflow-hidden border-b border-zinc-200">
					<div class="pointer-events-none absolute inset-0 opacity-70" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px), linear-gradient(0deg, rgba(24,24,27,0.035) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 pb-20 pt-16 text-center md:pb-24 md:pt-20">
						<p class="text-xs font-bold text-zinc-950">PROJECT</p>
						<h1 class="mx-auto mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-5xl">{ projectData.Name }</h1>
						<p class="mx-auto mt-6 max-w-2xl text-sm leading-6 text-zinc-500">{ projectData.Tagline }</p>
					</div>
				</section>
				<section class="border-b border-zinc-200 bg-white">
					<div class="mx-auto grid max-w-5xl grid-cols-1 px-6 md:grid-cols-3">
						<div class="border-b border-zinc-200 py-5 md:border-b-0 md:border-r md:pr-8">
							<p class="text-xs font-bold text-zinc-950">Type</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">{ projectData.ProjectTypeLabel() }</p>
						</div>
						<div class="border-b border-zinc-200 py-5 md:border-b-0 md:border-r md:px-8">
							<p class="text-xs font-bold text-zinc-950">Year</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">{ projectData.YearLabel() }</p>
						</div>
						<div class="py-5 md:pl-8">
							<p class="text-xs font-bold text-zinc-950">Source</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">{ projectData.SourceLabel() }</p>
						</div>
					</div>
				</section>
				if projectData.ImageURL != "" {
					<section class="bg-zinc-50">
						<div class="mx-auto max-w-5xl px-6 py-10 md:py-12">
							<img src={ projectData.ImageURL } alt={ projectData.Name } class="w-full bg-zinc-200 object-cover"/>
						</div>
					</section>
				}
				<section class="mx-auto grid max-w-5xl gap-12 px-6 py-20 md:grid-cols-[220px_1fr] md:py-24">
					<aside class="text-xs leading-5 text-zinc-500">
						<div class="flex h-10 items-center">
							if projectData.ImageURL != "" {
								<img src={ projectData.ImageURL } alt={ projectData.Name } class="max-h-9 w-auto object-contain"/>
							} else {
								<div class="flex h-9 w-9 items-center justify-center bg-zinc-950 text-xs font-bold text-white">
									{ projectData.Initial() }
								</div>
							}
						</div>
						<div class="mt-6 space-y-2">
							<p class="font-bold text-zinc-950">{ projectData.Name }</p>
							<p>{ projectData.ProjectTypeLabel() }</p>
							if projectData.DateLabel() != "" {
								<p>{ projectData.DateLabel() }</p>
							}
							if projectData.LiveURL != "" {
								<a href={ projectData.LiveURL } class="inline-flex font-bold text-zinc-950 transition-colors hover:text-zinc-500">Visit site</a>
							}
							if projectData.RepositoryURL != "" {
								<a href={ projectData.RepositoryURL } class="block font-bold text-zinc-950 transition-colors hover:text-zinc-500">View repository</a>
							} else {
								<p class="font-bold text-zinc-950">Closed-sourced</p>
							}
						</div>
					</aside>
					<div>
						if projectData.Description != "" {
							{{ parsedDescription := MarkdownToHTML(projectData.Description) }}
							<section>
								<h2 class="text-base font-bold text-zinc-950">Description</h2>
								<article class="prose prose-sm mt-5 max-w-2xl text-zinc-500 prose-headings:font-bold prose-headings:text-zinc-950 prose-a:text-zinc-950 prose-strong:text-zinc-950 prose-code:text-zinc-950 prose-pre:bg-zinc-950 prose-pre:text-zinc-100">
									@templ.Raw(parsedDescription)
								</article>
							</section>
						} else {
							<section>
								<h2 class="text-base font-bold text-zinc-950">Overview</h2>
								<p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-500">{ projectData.Tagline }</p>
							</section>
						}
						if len(technologies) > 0 {
							<section class="mt-12">
								<h2 class="text-base font-bold text-zinc-950">Built with</h2>
								<div class="mt-5 flex max-w-2xl flex-wrap gap-2">
									for _, technology := range technologies {
										<span class="bg-zinc-100 px-3 py-1 text-xs leading-5 text-zinc-500">{ technology }</span>
									}
								</div>
							</section>
						}
						<section class="mt-12">
							<h2 class="text-base font-bold text-zinc-950">Availability</h2>
							<div class="mt-5 grid max-w-2xl gap-4 border-t border-zinc-200 text-xs leading-5 text-zinc-500 sm:grid-cols-2">
								<div class="border-b border-zinc-200 py-5">
									<p class="font-bold text-zinc-950">Source</p>
									if projectData.RepositoryURL != "" {
										<a href={ projectData.RepositoryURL } class="mt-2 inline-flex font-bold text-zinc-950 transition-colors hover:text-zinc-500">Open repository</a>
									} else {
										<p class="mt-2">Closed-sourced</p>
									}
								</div>
								<div class="border-b border-zinc-200 py-5">
									<p class="font-bold text-zinc-950">Product</p>
									if projectData.LiveURL != "" {
										<a href={ projectData.LiveURL } class="mt-2 inline-flex font-bold text-zinc-950 transition-colors hover:text-zinc-500">Visit site</a>
									} else {
										<p class="mt-2">Private or not publicly hosted</p>
									}
								</div>
							</div>
						</section>
					</div>
				</section>
				<section class="relative overflow-hidden bg-zinc-50">
					<div class="pointer-events-none absolute inset-0 opacity-60" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 py-20 md:py-24">
						<h2 class="text-base font-bold text-zinc-950">More projects</h2>
						<div class="mt-8 border-t border-zinc-200">
							<a href={ routes.ProjectIndex.URL() } class="group block max-w-3xl border-b border-zinc-200 py-8">
								<p class="text-sm leading-6 text-zinc-500">Explore open source work, commercial products, automations, internal tools, and software experiments built in and through MBV Labs.</p>
								<h3 class="mt-5 text-base font-bold text-zinc-950 transition-colors group-hover:text-zinc-500">See all projects</h3>
							</a>
						</div>
					</div>
				</section>
			</main>
		}
	}
}

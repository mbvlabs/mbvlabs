package views

import (
	"mbvlabs/router/routes"
)

type ProjectInquiryIndex struct{}

func (pii ProjectInquiryIndex) PageFragment() string {
	return "projectinquiry-index-page-fragment"
}

templ (pii ProjectInquiryIndex) Page() {
	@themedBase(
		"cobalt-grid",
		SetTitle("Contact"),
		SetDescription("Tell MBV Labs about your software project, product engineering needs, or fractional tech lead support."),
		SetSlug(routes.ProjectInquiryIndex.URL()),
		SetSchema(ContactPageSchema()),
	) {
		@templ.Fragment(pii.PageFragment()) {
			<main id="projectinquiry-index-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Intake sheet / Project inquiry</p>
						<h1 class="cobalt-display mt-8 max-w-6xl">Let's work together.</h1>
						<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">Send a few details about what you are building, where the technical pressure is, and what kind of help would move the project forward.</p>
						<div class="mt-16 grid gap-5 border-t border-foreground pt-5 font-mono text-[11px] uppercase tracking-[0.12em] sm:grid-cols-3">
							<div><p class="font-medium">Channel</p><p class="mt-1 opacity-65">Project inquiry</p></div>
							<div><p class="font-medium">Location</p><p class="mt-1 opacity-65">Remote</p></div>
							<div><p class="font-medium">Inbox</p><p class="mt-1 opacity-65">hello@mbvlabs.com</p></div>
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="grid gap-16 lg:grid-cols-[0.65fr_1.35fr] lg:gap-24">
						<aside>
							<p class="font-mono text-xs uppercase tracking-[0.18em]">Direct contact / 01</p>
							<h2 class="cobalt-section-title mt-5">Email me.</h2>
							<p class="mt-6 max-w-md text-sm leading-6">Prefer to skip the form? Send the context directly and I will reply from the same inbox.</p>
							<a href="mailto:hello@mbvlabs.com" class="mt-6 inline-flex min-h-11 items-center border border-foreground px-4 py-2 text-sm font-semibold transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">hello@mbvlabs.com</a>
							<div class="mt-12 border-t border-foreground pt-7">
								<p class="font-mono text-xs uppercase tracking-[0.14em]">No public office</p>
								<p class="mt-5 max-w-md text-sm leading-6">MBV Labs works remotely with founders and lean teams. There is no public office address, careers page, or press desk to route through.</p>
							</div>
						</aside>

						<div>
							<div class="flex items-end justify-between gap-5 border-b border-foreground pb-6">
								<h2 class="cobalt-section-title">Project inquiry.</h2>
								<p class="hidden font-mono text-xs uppercase tracking-[0.12em] sm:block">Fields / 01-07</p>
							</div>
							<form method="post" action={ routes.ProjectInquiryCreate.URL() } class="mt-8 border border-foreground">
								<div class="divide-y divide-border">
									<div>
										<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="name">01 / Name</label>
										<input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="255" placeholder="Name" class="h-12 w-full border-0 bg-transparent px-5 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"/>
									</div>
									<div>
										<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="email">02 / Email</label>
										<input id="email" name="email" type="email" autocomplete="email" required maxlength="255" placeholder="Email" class="h-12 w-full border-0 bg-transparent px-5 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"/>
									</div>
									<div>
										<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="company">03 / Company</label>
										<input id="company" name="company" type="text" autocomplete="organization" maxlength="255" placeholder="Company" class="h-12 w-full border-0 bg-transparent px-5 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"/>
									</div>
									<div>
										<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="role">04 / Role</label>
										<input id="role" name="role" type="text" autocomplete="organization-title" maxlength="255" placeholder="Role" class="h-12 w-full border-0 bg-transparent px-5 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"/>
									</div>
									<div class="grid md:grid-cols-2 md:divide-x md:divide-border">
										<div>
											<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="projectType">05 / Project type</label>
											<select id="projectType" name="projectType" class="h-12 w-full border-0 bg-transparent px-5 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">
												<option value="">Project type</option>
												<option value="web-app">Web app</option>
												<option value="website">Website</option>
												<option value="automation">Automation</option>
												<option value="integration">Integration</option>
												<option value="consulting">Consulting</option>
												<option value="modernization">Modernization</option>
											</select>
										</div>
										<div class="border-t border-border md:border-t-0">
											<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="timeline">06 / Timeline</label>
											<select id="timeline" name="timeline" class="h-12 w-full border-0 bg-transparent px-5 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">
												<option value="">Timeline</option>
												<option value="asap">ASAP</option>
												<option value="1-3-months">1-3 months</option>
												<option value="3-6-months">3-6 months</option>
												<option value="flexible">Flexible</option>
											</select>
										</div>
									</div>
									<div>
										<label class="block px-5 pt-4 font-mono text-xs uppercase tracking-[0.12em]" for="message">07 / Message</label>
										<textarea id="message" name="message" required minlength="10" rows="5" placeholder="Message" class="min-h-36 w-full resize-y border-0 bg-transparent px-5 py-4 text-sm leading-6 text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"></textarea>
									</div>
								</div>
								<button type="submit" class="inline-flex min-h-14 w-full items-center justify-center border-t border-primary bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">
									Send inquiry
								</button>
							</form>
						</div>
					</div>
				</section>

				<section class="flex min-h-[60svh] items-center border-y border-foreground">
					<div class="container mx-auto px-6 py-24 md:px-8 md:py-28">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Intake principle / 01</p>
						<blockquote class="cobalt-quote mt-10 max-w-6xl">Good project notes make the first technical conversation much sharper.</blockquote>
						<div class="mt-14 flex items-center justify-between gap-5 border-t border-foreground pt-5 font-mono text-xs uppercase tracking-[0.12em]">
							<p class="font-medium">MBV Labs</p>
							<p class="opacity-65">Context / Pressure / Outcome</p>
						</div>
					</div>
				</section>
			</main>
		}
	}
}

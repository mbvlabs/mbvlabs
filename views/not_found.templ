package views

import "mbvlabs/router/routes"

templ NotFound() {
	@themedBase("cobalt-grid") {
		<main id="not-found-container" class="flex flex-1 bg-background font-sans text-foreground">
			<section class="flex w-full items-center border-y border-foreground">
				<div class="container mx-auto px-6 py-24 md:px-8 md:py-32">
					<p class="font-mono text-xs uppercase tracking-[0.18em]">System note / 404</p>
					<h1 class="cobalt-display mt-8 max-w-6xl">Not found.</h1>
					<p class="mt-8 max-w-xl text-base leading-7">The page you requested is not in this field report. Return home or continue through the public archive.</p>
					<nav class="mt-10 flex flex-wrap gap-3" aria-label="Recovery navigation">
						<a href={ routes.HomePage.URL() } class="inline-flex min-h-11 items-center border border-primary bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Return home</a>
						<a href={ routes.WorkIndex.URL() } class="inline-flex min-h-11 items-center border border-foreground px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View work</a>
						<a href={ routes.ProjectInquiryIndex.URL() } class="inline-flex min-h-11 items-center border border-foreground px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Contact</a>
					</nav>
					<div class="mt-16 flex flex-col gap-2 border-t border-foreground pt-5 font-mono text-[11px] uppercase tracking-[0.12em] sm:flex-row sm:items-center sm:justify-between">
						<p class="font-medium">Requested page / Unavailable</p>
						<p class="opacity-65">MBV Labs / Public system</p>
					</div>
				</div>
			</section>
		</main>
	}
}

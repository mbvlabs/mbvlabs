package views

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"mbvlabs/models"

	"mbvlabs/router/routes"
)

type BlogPostData struct {
	CreatedAt     time.Time
	UpdatedAt     time.Time
	Title         string
	Slug          string
	Excerpt       string
	Body          string
	Status        string
	CoverImageUrl string
	Tags          json.RawMessage
	PublishedAt   time.Time
}

func newBlogPostData(entity models.BlogPostEntity) BlogPostData {
	return BlogPostData{
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
		Title:     entity.Title,
		Slug:      entity.Slug,
		Excerpt: func() string {
			if !entity.Excerpt.Valid {
				return ""
			}
			return entity.Excerpt.String
		}(),
		Body:   entity.Body,
		Status: entity.Status,
		CoverImageUrl: func() string {
			if !entity.CoverImageUrl.Valid {
				return ""
			}
			return entity.CoverImageUrl.String
		}(),
		Tags: entity.Tags,
		PublishedAt: func() time.Time {
			if !entity.PublishedAt.Valid {
				return time.Time{}
			}
			return entity.PublishedAt.Time
		}(),
	}
}

func (bpd BlogPostData) PublishedLabel() string {
	if !bpd.PublishedAt.IsZero() {
		return bpd.PublishedAt.Format("January 2, 2006")
	}
	return bpd.CreatedAt.Format("January 2, 2006")
}

func (bpd BlogPostData) UpdatedLabel() string {
	return bpd.UpdatedAt.Format("January 2, 2006")
}

func (bpd BlogPostData) ShowUpdatedLabel() bool {
	return !bpd.PublishedAt.IsZero() && bpd.UpdatedAt.After(bpd.PublishedAt)
}

func (bpd BlogPostData) TagsList() []string {
	var tags []string
	if err := json.Unmarshal(bpd.Tags, &tags); err != nil {
		return nil
	}

	compactTags := tags[:0]
	for _, tag := range tags {
		tag = strings.TrimSpace(tag)
		if tag != "" {
			compactTags = append(compactTags, tag)
		}
	}

	return compactTags
}

type BlogPostIndex struct {
	Items []models.BlogPostEntity
}

func (bpi BlogPostIndex) PageFragment() string {
	return "blogpost-index-page-fragment"
}

templ (bpi BlogPostIndex) Page() {
	@themedBase(
		"cobalt-grid",
		SetTitle("Writing"),
		SetDescription("Pragmatic engineering notes from MBV Labs on product delivery, software architecture, and building maintainable systems."),
		SetSlug(routes.BlogPostIndex.URL()),
		SetSchema(BlogPostIndexSchema(bpi.Items)),
	) {
		@templ.Fragment(bpi.PageFragment()) {
			<main id="blogpost-index-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Field notes / Writing index</p>
						<h1 class="cobalt-display mt-8 max-w-6xl">Notes on building software that keeps moving.</h1>
						<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">Practical essays on product engineering, technical leadership, and the tradeoffs behind maintainable systems for focused teams.</p>
						<div class="mt-16 grid gap-5 border-t border-foreground pt-5 font-mono text-[11px] uppercase tracking-[0.12em] sm:grid-cols-3">
							<div><p class="font-medium">Format</p><p class="mt-1 opacity-65">Engineering dispatches</p></div>
							<div><p class="font-medium">Topics</p><p class="mt-1 opacity-65">Product / Systems / Teams</p></div>
							<div><p class="font-medium">Archive</p><p class="mt-1 opacity-65">Latest first</p></div>
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
						<div>
							<p class="font-mono text-xs uppercase tracking-[0.18em]">Dispatch archive</p>
							<h2 class="cobalt-section-title mt-4">Latest writing.</h2>
						</div>
						<p class="text-xs font-semibold uppercase tracking-[0.18em]">Practical notes / Current index</p>
					</div>
					if len(bpi.Items) == 0 {
						<div class="border-b border-border py-12">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">No writing is published yet.</p>
						</div>
					} else {
						<div>
							for index, blogpost := range bpi.Items {
								{{ blogpostData := newBlogPostData(blogpost) }}
								{{ tags := blogpostData.TagsList() }}
								<article>
									<a href={ routes.BlogPostShow.URL(blogpost.Slug) } class="group grid gap-6 border-b border-border py-12 transition-colors hover:bg-secondary/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring md:grid-cols-[4rem_minmax(10rem,0.65fr)_minmax(0,1.35fr)_7rem] md:items-start md:px-3">
										<p class="font-mono text-sm tracking-[0.08em]">{ fmt.Sprintf("%02d.", index+1) }</p>
										<div class="font-mono text-xs uppercase leading-5 tracking-[0.1em]">
											<p class="font-medium">{ blogpostData.PublishedLabel() }</p>
											if len(tags) > 0 {
												<ul class="mt-4 space-y-1 opacity-65" aria-label="Topics">
													for _, tag := range tags {
														<li>{ tag }</li>
													}
												</ul>
											}
										</div>
										<div>
											<h3 class="cobalt-row-title">{ blogpostData.Title }</h3>
											if blogpostData.Excerpt != "" {
												<p class="mt-4 max-w-2xl text-sm leading-6">{ blogpostData.Excerpt }</p>
											}
										</div>
										<span class="text-xs font-semibold uppercase tracking-[0.12em] transition-transform group-hover:translate-x-1 md:text-right">Read note →</span>
									</a>
								</article>
							}
						</div>
					}
				</section>

				if len(bpi.Items) > 0 {
					<section class="flex min-h-[60svh] items-center border-y border-foreground">
						<div class="container mx-auto px-6 py-24 md:px-8 md:py-28">
							<p class="font-mono text-xs uppercase tracking-[0.18em]">Working principle / 01</p>
							<blockquote class="cobalt-quote mt-10 max-w-6xl">Engineering decisions are product decisions when the team is small.</blockquote>
							<div class="mt-14 flex items-center justify-between gap-5 border-t border-foreground pt-5 font-mono text-xs uppercase tracking-[0.12em]">
								<p class="font-medium">MBV Labs</p>
								<p class="opacity-65">Decide / Build / Learn</p>
							</div>
						</div>
					</section>

					<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
						<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
							<h2 class="cobalt-section-title">What I write about.</h2>
							<p class="text-xs font-semibold uppercase tracking-[0.18em]">Editorial scope / Three fields</p>
						</div>
						<div class="grid md:grid-cols-3">
							<div class="border-b border-border py-10 md:border-r md:px-8 md:first:pl-0">
								<p class="font-mono text-xs tracking-[0.08em]">01.</p>
								<h3 class="cobalt-row-title mt-6">Product engineering</h3>
								<p class="mt-4 text-sm leading-6">Turning ambiguous goals into shipped systems.</p>
							</div>
							<div class="border-b border-border py-10 md:border-r md:px-8">
								<p class="font-mono text-xs tracking-[0.08em]">02.</p>
								<h3 class="cobalt-row-title mt-6">Technical leadership</h3>
								<p class="mt-4 text-sm leading-6">Clear choices for founders and lean teams.</p>
							</div>
							<div class="border-b border-border py-10 md:px-8 md:last:pr-0">
								<p class="font-mono text-xs tracking-[0.08em]">03.</p>
								<h3 class="cobalt-row-title mt-6">Maintainable systems</h3>
								<p class="mt-4 text-sm leading-6">Architecture, operations, and code that can change.</p>
							</div>
						</div>
					</section>
				}
			</main>
		}
	}
}

type BlogPostShow struct {
	Item models.BlogPostEntity
}

func (bps BlogPostShow) PageFragment() string {
	return "blogpost-show-page-fragment"
}

templ (bps BlogPostShow) Page() {
	{{ blogpostData := newBlogPostData(bps.Item) }}
	{{ tags := blogpostData.TagsList() }}
	@themedBase(
		"cobalt-grid",
		SetTitle(blogpostData.Title),
		SetDescription(blogpostData.Excerpt),
		SetSlug(routes.BlogPostShow.URL(blogpostData.Slug)),
		SetImage(blogpostData.CoverImageUrl),
		SetImageAlt(blogpostData.Title),
		SetMetaType("article"),
		SetSchema(BlogPostShowSchema(blogpostData, tags)),
	) {
		@templ.Fragment(bps.PageFragment()) {
			<main id="blogpost-show-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-28">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Dispatch / { blogpostData.PublishedLabel() }</p>
						<h1 class="cobalt-display mt-8 max-w-6xl">{ blogpostData.Title }</h1>
						if blogpostData.Excerpt != "" {
							<p class="mt-9 max-w-2xl text-base leading-7 md:text-lg">{ blogpostData.Excerpt }</p>
						}
					</div>
				</section>

				<section class="border-b border-foreground">
					<div class="container mx-auto grid px-6 md:grid-cols-3 md:px-8">
						<div class="border-b border-border py-6 md:border-b-0 md:border-r md:pr-8">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">01 / Published</p>
							<p class="mt-3 text-sm leading-6">{ blogpostData.PublishedLabel() }</p>
						</div>
						<div class="border-b border-border py-6 md:border-b-0 md:border-r md:px-8">
							if blogpostData.ShowUpdatedLabel() {
								<p class="font-mono text-xs uppercase tracking-[0.14em]">02 / Updated</p>
								<p class="mt-3 text-sm leading-6">{ blogpostData.UpdatedLabel() }</p>
							} else {
								<p class="font-mono text-xs uppercase tracking-[0.14em]">02 / Category</p>
								<p class="mt-3 text-sm leading-6">Writing</p>
							}
						</div>
						<div class="py-6 md:pl-8">
							<p class="font-mono text-xs uppercase tracking-[0.14em]">03 / Topics</p>
							<p class="mt-3 text-sm leading-6">
								if len(tags) > 0 {
									{ strings.Join(tags, ", ") }
								} else {
									Product engineering
								}
							</p>
						</div>
					</div>
				</section>

				if blogpostData.CoverImageUrl != "" {
					<section class="border-b border-foreground bg-secondary/45">
						<div class="container mx-auto px-6 py-10 md:px-8 md:py-14">
							<img src={ blogpostData.CoverImageUrl } alt={ blogpostData.Title } class="w-full border border-foreground bg-muted object-cover"/>
						</div>
					</section>
				}

				<section class="container mx-auto grid gap-16 px-6 py-20 md:px-8 md:py-24 lg:grid-cols-[minmax(12rem,0.45fr)_minmax(0,1.55fr)] lg:gap-24">
					<aside class="text-xs uppercase leading-5 tracking-[0.12em] lg:sticky lg:top-24 lg:self-start">
						<p class="font-mono opacity-65">Article record</p>
						<div class="mt-5 border-t border-foreground pt-5">
							<p class="font-semibold">{ blogpostData.PublishedLabel() }</p>
							if blogpostData.ShowUpdatedLabel() {
								<p class="mt-2 font-mono opacity-65">Updated { blogpostData.UpdatedLabel() }</p>
							}
							if len(tags) > 0 {
								<div class="mt-6">
									<p class="font-mono opacity-65">Topics</p>
									<ul class="mt-3 space-y-1">
										for _, tag := range tags {
											<li>{ tag }</li>
										}
									</ul>
								</div>
							}
						</div>
						<a href={ routes.BlogPostIndex.URL() } class="mt-8 inline-flex min-h-11 items-center border border-foreground px-4 py-2 font-semibold transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">← All writing</a>
					</aside>

					<div class="min-w-0">
						if blogpostData.Body != "" {
							{{ parsedBody := MarkdownToHTML(blogpostData.Body) }}
							<article class="prose max-w-3xl text-foreground prose-headings:font-heading prose-headings:font-bold prose-headings:text-foreground prose-p:text-foreground prose-a:text-foreground prose-a:underline prose-a:decoration-1 prose-a:underline-offset-4 prose-strong:text-foreground prose-code:text-foreground prose-code:before:content-none prose-code:after:content-none prose-li:text-foreground prose-ul:marker:text-foreground prose-ol:marker:text-foreground prose-hr:border-foreground prose-img:rounded-none prose-img:border prose-img:border-foreground prose-pre:rounded-none prose-pre:border prose-pre:border-foreground prose-pre:bg-primary prose-pre:text-primary-foreground prose-blockquote:border-foreground prose-blockquote:font-heading prose-blockquote:font-normal prose-blockquote:text-foreground">
								@templ.Raw(parsedBody)
							</article>
						} else if blogpostData.Excerpt != "" {
							<article class="max-w-3xl text-base leading-7">
								<p>{ blogpostData.Excerpt }</p>
							</article>
						}
					</div>
				</section>

				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-24">
						<p class="font-mono text-xs uppercase tracking-[0.18em]">Archive / Continue reading</p>
						<h2 class="cobalt-section-title mt-5">More writing.</h2>
						<a href={ routes.BlogPostIndex.URL() } class="group mt-10 grid gap-6 border-y border-border py-10 transition-colors hover:bg-secondary/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring md:grid-cols-[minmax(0,1fr)_8rem] md:items-end md:px-3">
							<div>
								<p class="max-w-3xl text-sm leading-6">Read more practical notes on product engineering, technical leadership, software architecture, and the delivery tradeoffs behind maintainable systems for focused teams.</p>
								<h3 class="cobalt-row-title mt-6">Read all writing</h3>
							</div>
							<span class="text-xs font-semibold uppercase tracking-[0.12em] transition-transform group-hover:translate-x-1 md:text-right">Open index →</span>
						</a>
					</div>
				</section>
			</main>
		}
	}
}

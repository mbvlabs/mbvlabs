package views

import (
	"encoding/json"
	"strings"
	"time"

	"mbvlabs/models"

	"mbvlabs/router/routes"
)

type BlogPostData struct {
	CreatedAt     time.Time
	UpdatedAt     time.Time
	Title         string
	Slug          string
	Excerpt       string
	Body          string
	Status        string
	CoverImageUrl string
	Tags          json.RawMessage
	PublishedAt   time.Time
}

func newBlogPostData(entity models.BlogPostEntity) BlogPostData {
	return BlogPostData{
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
		Title:     entity.Title,
		Slug:      entity.Slug,
		Excerpt: func() string {
			if !entity.Excerpt.Valid {
				return ""
			}
			return entity.Excerpt.String
		}(),
		Body:   entity.Body,
		Status: entity.Status,
		CoverImageUrl: func() string {
			if !entity.CoverImageUrl.Valid {
				return ""
			}
			return entity.CoverImageUrl.String
		}(),
		Tags: entity.Tags,
		PublishedAt: func() time.Time {
			if !entity.PublishedAt.Valid {
				return time.Time{}
			}
			return entity.PublishedAt.Time
		}(),
	}
}

func (bpd BlogPostData) PublishedLabel() string {
	if !bpd.PublishedAt.IsZero() {
		return bpd.PublishedAt.Format("January 2, 2006")
	}
	return bpd.CreatedAt.Format("January 2, 2006")
}

func (bpd BlogPostData) UpdatedLabel() string {
	return bpd.UpdatedAt.Format("January 2, 2006")
}

func (bpd BlogPostData) ShowUpdatedLabel() bool {
	return !bpd.PublishedAt.IsZero() && bpd.UpdatedAt.After(bpd.PublishedAt)
}

func (bpd BlogPostData) TagsList() []string {
	var tags []string
	if err := json.Unmarshal(bpd.Tags, &tags); err != nil {
		return nil
	}

	compactTags := tags[:0]
	for _, tag := range tags {
		tag = strings.TrimSpace(tag)
		if tag != "" {
			compactTags = append(compactTags, tag)
		}
	}

	return compactTags
}

type BlogPostIndex struct {
	Items []models.BlogPostEntity
}

func (bpi BlogPostIndex) PageFragment() string {
	return "blogpost-index-page-fragment"
}

templ (bpi BlogPostIndex) Page() {
	@base(
		SetTitle("Writing"),
		SetDescription("Pragmatic engineering notes from MBV Labs on product delivery, software architecture, and building maintainable systems."),
		SetSlug(routes.BlogPostIndex.URL()),
		SetSchema(BlogPostIndexSchema(bpi.Items)),
	) {
		@templ.Fragment(bpi.PageFragment()) {
			<main id="blogpost-index-container" class="overflow-hidden bg-white">
				<section class="relative">
					<div class="pointer-events-none absolute inset-0 opacity-70" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px), linear-gradient(0deg, rgba(24,24,27,0.035) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 pb-24 pt-20 md:pb-28 md:pt-24">
						<div class="max-w-2xl">
							<p class="text-xs font-bold text-zinc-950">Writing</p>
							<h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-5xl">Notes on building software that keeps moving.</h1>
							<p class="mt-6 max-w-xl text-sm leading-6 text-zinc-500">Practical essays on product engineering, technical leadership, and the tradeoffs behind maintainable systems for focused teams.</p>
						</div>
					</div>
				</section>
				if len(bpi.Items) == 0 {
					<section class="mx-auto max-w-5xl px-6 pb-24">
						<div class="border-t border-zinc-200 pt-10">
							<p class="text-sm text-zinc-500">No writing is published yet.</p>
						</div>
					</section>
				} else {
					<section class="mx-auto max-w-5xl px-6 pb-24 md:pb-32">
						<div class="flex items-center gap-4">
							<h2 class="shrink-0 text-base font-bold text-zinc-950">Latest writing</h2>
							<div class="h-px flex-1 bg-zinc-200"></div>
						</div>
						<div class="mt-8">
							for _, blogpost := range bpi.Items {
								{{ blogpostData := newBlogPostData(blogpost) }}
								{{ tags := blogpostData.TagsList() }}
								<article class="border-t border-zinc-200 py-12 md:py-16">
									<div class="grid gap-8 md:grid-cols-[220px_1fr] md:gap-14">
										<aside class="space-y-5 text-xs leading-5 text-zinc-500">
											<p>{ blogpostData.PublishedLabel() }</p>
											if len(tags) > 0 {
												<div>
													<p class="font-bold text-zinc-950">Topics</p>
													<ul class="mt-2 space-y-1">
														for _, tag := range tags {
															<li>{ tag }</li>
														}
													</ul>
												</div>
											}
										</aside>
										<div>
											<h3 class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-3xl">{ blogpostData.Title }</h3>
											if blogpostData.Excerpt != "" {
												<p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-500">{ blogpostData.Excerpt }</p>
											}
											<div class="mt-6">
												<a href={ routes.BlogPostShow.URL(blogpost.Slug) } class="inline-flex bg-zinc-950 px-4 py-2 text-xs font-bold text-white transition-colors hover:bg-zinc-700">
													Read article
												</a>
											</div>
										</div>
									</div>
								</article>
							}
						</div>
					</section>
					<section class="relative bg-zinc-50">
						<div class="pointer-events-none absolute inset-0 opacity-60" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
						<div class="relative mx-auto max-w-5xl px-6 py-20 md:py-24">
							<blockquote class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-3xl">
								Engineering decisions are product decisions when the team is small.
							</blockquote>
							<div class="mt-7 flex items-center gap-3">
								<span class="inline-flex h-6 w-6 items-center justify-center bg-zinc-950 text-[10px] font-bold text-white">M</span>
								<p class="text-xs font-bold uppercase text-zinc-950">mbvlabs.</p>
							</div>
						</div>
					</section>
					<section class="mx-auto max-w-5xl px-6 py-20 md:py-24">
						<div class="grid gap-10 md:grid-cols-[220px_1fr] md:gap-14">
							<div>
								<h2 class="text-base font-bold text-zinc-950">What I write about</h2>
							</div>
							<div class="grid gap-8 border-t border-zinc-200 pt-8 md:grid-cols-3">
								<div>
									<p class="text-xs font-bold text-zinc-950">Product engineering</p>
									<p class="mt-3 text-xs leading-5 text-zinc-500">Turning ambiguous goals into shipped systems.</p>
								</div>
								<div>
									<p class="text-xs font-bold text-zinc-950">Technical leadership</p>
									<p class="mt-3 text-xs leading-5 text-zinc-500">Clear choices for founders and lean teams.</p>
								</div>
								<div>
									<p class="text-xs font-bold text-zinc-950">Maintainable systems</p>
									<p class="mt-3 text-xs leading-5 text-zinc-500">Architecture, operations, and code that can change.</p>
								</div>
							</div>
						</div>
					</section>
				}
			</main>
		}
	}
}

type BlogPostShow struct {
	Item models.BlogPostEntity
}

func (bps BlogPostShow) PageFragment() string {
	return "blogpost-show-page-fragment"
}

templ (bps BlogPostShow) Page() {
	{{ blogpostData := newBlogPostData(bps.Item) }}
	{{ tags := blogpostData.TagsList() }}
	@base(
		SetTitle(blogpostData.Title),
		SetDescription(blogpostData.Excerpt),
		SetSlug(routes.BlogPostShow.URL(blogpostData.Slug)),
		SetImage(blogpostData.CoverImageUrl),
		SetImageAlt(blogpostData.Title),
		SetMetaType("article"),
		SetSchema(BlogPostShowSchema(blogpostData, tags)),
	) {
		@templ.Fragment(bps.PageFragment()) {
			<main id="blogpost-show-container" class="overflow-hidden bg-white">
				<section class="relative overflow-hidden border-b border-zinc-200">
					<div class="pointer-events-none absolute inset-0 opacity-70" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px), linear-gradient(0deg, rgba(24,24,27,0.035) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 pb-20 pt-16 text-center md:pb-24 md:pt-20">
						<p class="text-xs font-bold text-zinc-950">{ blogpostData.PublishedLabel() }</p>
						<h1 class="mx-auto mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-5xl">{ blogpostData.Title }</h1>
						if blogpostData.Excerpt != "" {
							<p class="mx-auto mt-6 max-w-2xl text-sm leading-6 text-zinc-500">{ blogpostData.Excerpt }</p>
						}
					</div>
				</section>
				<section class="border-b border-zinc-200 bg-white">
					<div class="mx-auto grid max-w-5xl grid-cols-1 px-6 md:grid-cols-3">
						<div class="border-b border-zinc-200 py-5 md:border-b-0 md:border-r md:pr-8">
							<p class="text-xs font-bold text-zinc-950">Published</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">{ blogpostData.PublishedLabel() }</p>
						</div>
						<div class="border-b border-zinc-200 py-5 md:border-b-0 md:border-r md:px-8">
							if blogpostData.ShowUpdatedLabel() {
								<p class="text-xs font-bold text-zinc-950">Updated</p>
								<p class="mt-1 text-xs leading-5 text-zinc-500">{ blogpostData.UpdatedLabel() }</p>
							} else {
								<p class="text-xs font-bold text-zinc-950">Category</p>
								<p class="mt-1 text-xs leading-5 text-zinc-500">Writing</p>
							}
						</div>
						<div class="py-5 md:pl-8">
							<p class="text-xs font-bold text-zinc-950">Topics</p>
							<p class="mt-1 text-xs leading-5 text-zinc-500">
								if len(tags) > 0 {
									{ strings.Join(tags, ", ") }
								} else {
									Product engineering
								}
							</p>
						</div>
					</div>
				</section>
				if blogpostData.CoverImageUrl != "" {
					<section class="bg-zinc-50">
						<div class="mx-auto max-w-5xl px-6 py-10 md:py-12">
							<img src={ blogpostData.CoverImageUrl } alt={ blogpostData.Title } class="w-full bg-zinc-200 object-cover"/>
						</div>
					</section>
				}
				<section class="mx-auto grid max-w-5xl gap-12 px-6 py-20 md:grid-cols-[220px_1fr] md:py-24">
					<aside class="text-xs leading-5 text-zinc-500">
						<p class="font-bold text-zinc-950">Article</p>
						<div class="mt-6 space-y-2">
							<p>{ blogpostData.PublishedLabel() }</p>
							if blogpostData.ShowUpdatedLabel() {
								<p>Updated { blogpostData.UpdatedLabel() }</p>
							}
							if len(tags) > 0 {
								<div>
									<p class="font-bold text-zinc-950">Topics</p>
									<ul class="mt-2 space-y-1">
										for _, tag := range tags {
											<li>{ tag }</li>
										}
									</ul>
								</div>
							}
						</div>
						<a href={ routes.BlogPostIndex.URL() } class="mt-8 inline-flex font-bold text-zinc-950 transition-colors hover:text-zinc-500">All writing</a>
					</aside>
					<div>
						if blogpostData.Body != "" {
							{{ parsedBody := MarkdownToHTML(blogpostData.Body) }}
							<article class="prose prose-sm max-w-2xl text-zinc-500 prose-headings:font-bold prose-headings:text-zinc-950 prose-a:text-zinc-950 prose-strong:text-zinc-950 prose-code:text-zinc-950 prose-pre:bg-zinc-950 prose-pre:text-zinc-100">
								@templ.Raw(parsedBody)
							</article>
						} else if blogpostData.Excerpt != "" {
							<article class="max-w-2xl text-sm leading-6 text-zinc-500">
								<p>{ blogpostData.Excerpt }</p>
							</article>
						}
					</div>
				</section>
				<section class="relative overflow-hidden bg-zinc-50">
					<div class="pointer-events-none absolute inset-0 opacity-60" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 py-20 md:py-24">
						<h2 class="text-base font-bold text-zinc-950">More writing</h2>
						<div class="mt-8 border-t border-zinc-200">
							<a href={ routes.BlogPostIndex.URL() } class="group block max-w-3xl border-b border-zinc-200 py-8">
								<p class="text-sm leading-6 text-zinc-500">Read more practical notes on product engineering, technical leadership, software architecture, and the delivery tradeoffs behind maintainable systems for focused teams.</p>
								<h3 class="mt-5 text-base font-bold text-zinc-950 transition-colors group-hover:text-zinc-500">Read all writing</h3>
							</a>
						</div>
					</div>
				</section>
			</main>
		}
	}
}

package views

import (
	"mbvlabs/config"
	"mbvlabs/internal/request"
	"mbvlabs/internal/server"
	"mbvlabs/router/cookies"
	"mbvlabs/router/routes"
	"time"
)

func flashMessageClass(flashType cookies.FlashType) string {
	base := "max-w-sm border px-4 py-3 text-sm font-semibold shadow-lg"
	switch flashType {
	case cookies.FlashSuccess:
		return base + " border-green-600 bg-green-600 text-white"
	case cookies.FlashError:
		return base + " border-red-600 bg-red-600 text-white"
	default:
		return base + " border-zinc-950 bg-zinc-950 text-white"
	}
}

templ base(headOpts ...HeadDataOption) {
	<!DOCTYPE html>
	<html lang="en">
		@SetupHead(ctx, headOpts...)
		<body class="flex min-h-screen flex-col bg-white text-zinc-950 antialiased">
			@SiteHeader()
			<div class="flex-1">
				{ children... }
			</div>
			@SiteFooter()
			<div id="flashContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2">
				for _, flash := range request.ExtractContext[[]cookies.FlashMessage](ctx, request.SessionFlashesKey) {
					<div class={ flashMessageClass(flash.Type) }>
						{ flash.Message }
					</div>
				}
			</div>
			if config.Env == server.ProdEnvironment {
				<script defer src="https://analytics.mbvlabs.com/t/script.js" data-website-id="d6e66aea-49c8-4db8-964e-d0fbc98aed85"></script>
			}
		</body>
	</html>
}

templ SiteHeader() {
	<header class="sticky top-0 z-50 bg-white/85 backdrop-blur" data-signals:mobileNavOpen="false">
		<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-7">
			<a href={ routes.HomePage.URL() } class="inline-flex items-center gap-2 text-sm font-bold tracking-tight text-zinc-950" aria-label="mbvlabs home">
				<span class="inline-flex h-4 w-5 items-center justify-center">
					<svg class="h-4 w-5" viewBox="0 0 24 18" fill="none" aria-hidden="true">
						<path d="M2 12.5L8 6.5L13 11.5L22 2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
						<path d="M2 17H8.5L14 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity=".55"></path>
					</svg>
				</span>
				<span>mbvlabs.</span>
			</a>
			<nav class="flex items-center gap-3" aria-label="Primary navigation">
				<a href={ routes.ServiceOfferingIndex.URL() } class="hidden text-xs font-semibold text-zinc-500 transition-colors hover:text-zinc-950 md:inline-flex">Services</a>
				<a href={ routes.WorkIndex.URL() } class="hidden text-xs font-semibold text-zinc-500 transition-colors hover:text-zinc-950 md:inline-flex">Work</a>
				<a href={ routes.ProjectIndex.URL() } class="hidden text-xs font-semibold text-zinc-500 transition-colors hover:text-zinc-950 md:inline-flex">Projects</a>
				<a href={ routes.BlogPostIndex.URL() } class="hidden text-xs font-semibold text-zinc-500 transition-colors hover:text-zinc-950 md:inline-flex">Writing</a>
				<a href={ routes.AboutMe.URL() } class="hidden text-xs font-semibold text-zinc-500 transition-colors hover:text-zinc-950 md:inline-flex">About</a>
				<a href={ routes.ProjectInquiryIndex.URL() } class="bg-zinc-950 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-zinc-700">Contact me</a>
				<button class="inline-flex h-8 w-8 items-center justify-center text-zinc-950 transition-colors hover:text-zinc-500 md:hidden" type="button" aria-label="Open menu" aria-controls="mobile-navigation" data-attr:aria-expanded="$mobileNavOpen ? 'true' : 'false'" data-on:click="$mobileNavOpen = true">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M5 8H19M5 16H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</nav>
		</div>
		<div id="mobile-navigation" class="fixed inset-0 z-[60] min-h-screen overflow-y-auto bg-zinc-950 px-6 py-7 text-white md:hidden" style="display: none;" data-show="$mobileNavOpen">
			<div class="mx-auto flex max-w-5xl items-center justify-between">
				<a href={ routes.HomePage.URL() } class="inline-flex items-center gap-2 text-sm font-bold tracking-tight text-white" aria-label="mbvlabs home" data-on:click="$mobileNavOpen = false">
					<span class="inline-flex h-4 w-5 items-center justify-center">
						<svg class="h-4 w-5" viewBox="0 0 24 18" fill="none" aria-hidden="true">
							<path d="M2 12.5L8 6.5L13 11.5L22 2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
							<path d="M2 17H8.5L14 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity=".55"></path>
						</svg>
					</span>
					<span>mbvlabs.</span>
				</a>
				<button class="inline-flex h-8 w-8 items-center justify-center text-white transition-colors hover:text-white/60" type="button" aria-label="Close menu" data-on:click="$mobileNavOpen = false">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
			<nav class="mx-auto mt-16 max-w-5xl" aria-label="Mobile navigation">
				<ul class="space-y-1">
					<li><a href={ routes.HomePage.URL() } class="block border-t border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">Home</a></li>
					<li><a href={ routes.WorkIndex.URL() } class="block border-t border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">Work</a></li>
					<li><a href={ routes.ProjectIndex.URL() } class="block border-t border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">Projects</a></li>
					<li><a href={ routes.ServiceOfferingIndex.URL() } class="block border-t border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">Services</a></li>
					<li><a href={ routes.AboutMe.URL() } class="block border-t border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">About</a></li>
					<li><a href={ routes.BlogPostIndex.URL() } class="block border-t border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">Writing</a></li>
					<li><a href={ routes.ProjectInquiryIndex.URL() } class="block border-y border-white/10 py-5 text-3xl font-semibold tracking-tight text-white transition-colors hover:text-white/60" data-on:click="$mobileNavOpen = false">Contact</a></li>
				</ul>
			</nav>
		</div>

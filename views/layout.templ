package views

import (
	"mbvlabs/config"
	"mbvlabs/internal/request"
	"mbvlabs/internal/server"
	"mbvlabs/router/cookies"
	"mbvlabs/router/routes"
	"time"
)

func flashMessageClass(flashType cookies.FlashType) string {
	base := "max-w-sm border px-4 py-3 text-sm font-semibold shadow-lg"
	switch flashType {
	case cookies.FlashSuccess:
		return base + " border-green-600 bg-green-600 text-white"
	case cookies.FlashError:
		return base + " border-red-600 bg-red-600 text-white"
	default:
		return base + " border-zinc-950 bg-zinc-950 text-white"
	}
}

templ base(headOpts ...HeadDataOption) {
	@baseLayout("", headOpts...) {
		{ children... }
	}
}

templ themedBase(theme string, headOpts ...HeadDataOption) {
	@baseLayout(theme, headOpts...) {
		{ children... }
	}
}

templ Breadcrumbs(items []SchemaBreadcrumb) {
	<nav aria-label="Breadcrumb">
		<ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
			for index, item := range items {
				<li class="inline-flex items-center gap-1.5">
					if index > 0 {
						<span aria-hidden="true">/</span>
					}
					if index == len(items)-1 {
						<span class="font-medium text-foreground" aria-current="page">{ item.Name }</span>
					} else {
						<a href={ item.Path } class="transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{ item.Name }</a>
					}
				</li>
			}
		</ol>
	</nav>
}

templ baseLayout(theme string, headOpts ...HeadDataOption) {
	<!DOCTYPE html>
	<html lang="en">
		@SetupHead(ctx, headOpts...)
		<body class={ "flex min-h-screen flex-col bg-background text-foreground antialiased " + theme }>
			@SiteHeader()
			<div class="flex-1">
				{ children... }
			</div>
			@SiteFooter()
			<div id="flashContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2">
				for _, flash := range request.ExtractContext[[]cookies.FlashMessage](ctx, request.SessionFlashesKey) {
					<div class={ flashMessageClass(flash.Type) }>
						{ flash.Message }
					</div>
				}
			</div>
			if config.Env == server.ProdEnvironment {
				<script defer src="https://analytics.mbvlabs.com/t/script.js" data-website-id="d6e66aea-49c8-4db8-964e-d0fbc98aed85"></script>
			}
		</body>
	</html>
}

templ SiteHeader() {
	<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur" data-signals:mobileNavOpen="false">
		<div class="container mx-auto flex items-center justify-between px-6 py-5 md:px-8">
			<a href={ routes.HomePage.URL() } class="inline-flex items-center gap-2 text-sm font-bold tracking-tight text-foreground" aria-label="mbvlabs home">
				<span class="inline-flex h-4 w-5 items-center justify-center">
					<svg class="h-4 w-5" viewBox="0 0 24 18" fill="none" aria-hidden="true">
						<path d="M2 12.5L8 6.5L13 11.5L22 2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
						<path d="M2 17H8.5L14 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity=".55"></path>
					</svg>
				</span>
				<span>mbvlabs.</span>
			</a>
			<nav class="flex items-center gap-5" aria-label="Primary navigation">
				<a href={ routes.ServiceOfferingIndex.URL() } class="hidden text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground md:inline-flex">Services</a>
				<a href={ routes.WorkIndex.URL() } class="hidden text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground md:inline-flex">Work</a>
				<a href={ routes.ProjectIndex.URL() } class="hidden text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground md:inline-flex">Projects</a>
				<a href={ routes.BlogPostIndex.URL() } class="hidden text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground md:inline-flex">Blog</a>
				<a href={ routes.AboutMe.URL() } class="hidden text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground md:inline-flex">About</a>
				<a href={ routes.ProjectInquiryIndex.URL() } class="border border-primary bg-primary px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary">Contact</a>
				<button class="inline-flex h-9 w-9 items-center justify-center text-foreground transition-opacity hover:opacity-60 md:hidden" type="button" aria-label="Open menu" aria-controls="mobile-navigation" data-attr:aria-expanded="$mobileNavOpen ? 'true' : 'false'" data-on:click="$mobileNavOpen = true">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M5 8H19M5 16H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</nav>
		</div>
		<div id="mobile-navigation" class="fixed inset-0 z-[60] min-h-screen overflow-y-auto bg-primary px-6 py-7 text-primary-foreground md:hidden" style="display: none;" data-show="$mobileNavOpen">
			<div class="flex items-center justify-between">
				<a href={ routes.HomePage.URL() } class="inline-flex items-center gap-2 text-sm font-bold" aria-label="mbvlabs home" data-on:click="$mobileNavOpen = false">mbvlabs.</a>
				<button class="inline-flex h-9 w-9 items-center justify-center transition-opacity hover:opacity-60" type="button" aria-label="Close menu" data-on:click="$mobileNavOpen = false">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
			<nav class="mt-16" aria-label="Mobile navigation">
				<ul>
					<li><a href={ routes.HomePage.URL() } class="block border-t border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">Home</a></li>
					<li><a href={ routes.WorkIndex.URL() } class="block border-t border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">Work</a></li>
					<li><a href={ routes.ProjectIndex.URL() } class="block border-t border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">Projects</a></li>
					<li><a href={ routes.ServiceOfferingIndex.URL() } class="block border-t border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">Services</a></li>
					<li><a href={ routes.AboutMe.URL() } class="block border-t border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">About</a></li>
					<li><a href={ routes.BlogPostIndex.URL() } class="block border-t border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">Blog</a></li>
					<li><a href={ routes.ProjectInquiryIndex.URL() } class="block border-y border-primary-foreground/20 py-5 font-heading text-4xl" data-on:click="$mobileNavOpen = false">Contact</a></li>
				</ul>
			</nav>
		</div>
	</header>
}

templ SiteFooter() {
	<footer id="contact" class="border-t border-foreground bg-background text-foreground">
		<div class="container mx-auto px-6 py-16 md:px-8 md:py-24">
			<div class="grid gap-10 border-b border-foreground pb-16 lg:grid-cols-[1.4fr_0.6fr] lg:items-end">
				<div>
					<p class="text-xs font-semibold uppercase tracking-[0.18em]">Next engagement / Open</p>
					<h2 class="mt-7 max-w-4xl font-heading text-4xl font-normal leading-[0.98] md:text-5xl lg:text-6xl">Tell me about the software you need to ship.</h2>
				</div>
				<div>
					<p class="max-w-md text-sm leading-6">Senior engineering judgment, hands-on implementation, and a clear path from product ambiguity to maintainable production software.</p>
					<a href={ routes.ProjectInquiryIndex.URL() } class="mt-8 inline-flex min-h-11 items-center border border-primary bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary">Start an inquiry</a>
				</div>
			</div>
			<div class="grid gap-10 py-12 text-xs sm:grid-cols-2 lg:grid-cols-5">
				<div><p class="font-semibold uppercase tracking-[0.14em]">Work</p><ul class="mt-4 space-y-3 opacity-70"><li><a href={ routes.WorkIndex.URL() }>Client work</a></li><li><a href={ routes.ProjectIndex.URL() }>Projects</a></li></ul></div>
				<div><p class="font-semibold uppercase tracking-[0.14em]">Company</p><ul class="mt-4 space-y-3 opacity-70"><li><a href={ routes.ServiceOfferingIndex.URL() }>Services</a></li><li><a href={ routes.AboutMe.URL() }>About</a></li></ul></div>
				<div><p class="font-semibold uppercase tracking-[0.14em]">Connect</p><ul class="mt-4 space-y-3 opacity-70"><li><a href={ routes.BlogPostIndex.URL() }>Blog</a></li><li><a href={ routes.BlogPostFeed.URL() }>RSS</a></li><li><a href="mailto:hello@mbvlabs.com">Email</a></li></ul></div>
				<div><p class="font-semibold uppercase tracking-[0.14em]">Social</p><ul class="mt-4 space-y-3 opacity-70"><li><a href="https://www.youtube.com/@mbvlabs" target="_blank" rel="noreferrer">YouTube</a></li><li><a href="https://x.com/mbvlabs" target="_blank" rel="noreferrer">X</a></li><li><a href="https://www.linkedin.com/in/mortenvistisen" target="_blank" rel="noreferrer">LinkedIn</a></li><li><a href="https://github.com/mbvlabs" target="_blank" rel="noreferrer">GitHub</a></li></ul></div>
				<div><p class="font-semibold uppercase tracking-[0.14em]">Field notes</p><p class="mt-4 max-w-sm leading-5 opacity-70">Pragmatic engineering decisions, shipped systems, and the tradeoffs behind founder-led products.</p></div>
			</div>
			<div class="flex flex-col gap-4 border-t border-border pt-6 font-mono text-[11px] tracking-[0.08em] sm:flex-row sm:items-center sm:justify-between">
				<a href={ routes.HomePage.URL() } class="font-semibold" aria-label="mbvlabs home">mbvlabs.</a>
				<p>&copy; { time.Now().Format("2006") } / FIELD OFFICE</p>
			</div>
		</div>
	</footer>
}

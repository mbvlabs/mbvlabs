package views

import (
	"fmt"
	"mbvlabs/models"
	"mbvlabs/router/routes"
)

type LandingPage struct {
	FeaturedWorks    []models.WorkEntity
	FeaturedProjects []models.ProjectEntity
}

func (lp LandingPage) PageFragment() string {
	return "landing-page-fragment"
}

templ (lp LandingPage) Page() {
	@themedBase(
		"cobalt-grid",
		SetTitle("Fractional Tech Lead"),
		SetDescription("MBV Labs helps founders and lean teams turn ambiguous software goals into shipped production systems."),
		SetSlug(routes.HomePage.URL()),
		SetSchema(HomePageSchema()),
	) {
		@templ.Fragment(lp.PageFragment()) {
			<main id="landing-page-fragment-container" class="overflow-hidden bg-background font-sans text-foreground">
				<section class="relative isolate min-h-[680px] border-y border-foreground md:min-h-[calc(100svh-72px)]">
					<div class="container relative mx-auto flex min-h-[680px] flex-col px-6 py-8 md:min-h-[calc(100svh-72px)] md:px-8 md:py-10">
						<div class="cobalt-scanlines pointer-events-none absolute bottom-24 right-8 top-10 z-0 hidden w-[28%] max-w-[24rem] md:block" aria-hidden="true"></div>
						<div class="h-px w-full bg-foreground"></div>
						<div class="flex flex-1 items-center py-16 md:py-20">
							<div class="relative z-10 w-full md:max-w-[62%] xl:max-w-[52rem]">
								<p class="text-xs font-semibold uppercase tracking-[0.18em]">Field office / Senior product engineering</p>
								<h1 class="cobalt-display mt-7">Fractional tech lead for founders who need software shipped.</h1>
								<p class="mt-8 max-w-xl text-base leading-7 md:text-lg">I help lean teams shape ambiguous product goals, make practical architecture decisions, and build production web apps, internal tools, automations, and developer infrastructure.</p>
								<div class="mt-9 flex flex-wrap gap-3">
									<a href={ routes.ProjectInquiryIndex.URL() } class="inline-flex min-h-11 items-center border border-primary bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Start an inquiry</a>
									<a href={ routes.WorkIndex.URL() } class="inline-flex min-h-11 items-center border border-foreground px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View work</a>
								</div>
							</div>
						</div>
						<div class="grid gap-5 border-t border-foreground pt-5 text-[11px] uppercase tracking-[0.14em] sm:grid-cols-3">
							<div><p class="font-semibold">Issue 01</p><p class="mt-1 opacity-70">MBV Labs / 2026</p></div>
							<div><p class="font-semibold">Focus</p><p class="mt-1 opacity-70">Plan / Build / Improve</p></div>
							<div><p class="font-semibold">Working model</p><p class="mt-1 opacity-70">Senior judgment / Hands-on delivery</p></div>
						</div>
					</div>
				</section>

				<section class="border-b border-foreground">
					<div class="container mx-auto px-6 py-16 md:px-8 md:py-20">
						<div class="flex items-end justify-between gap-6">
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.18em]">Trusted technical work</p>
								<h2 class="cobalt-section-title mt-4">Selected client ledger.</h2>
							</div>
							<p class="hidden font-mono text-xs tracking-[0.08em] md:block">CLIENTS / 001-005</p>
						</div>
						<div class="mt-10 grid border-y border-foreground md:grid-cols-5">
							@landingClientEntry("01.", "YLD")
							@landingClientEntry("02.", "everphone")
							@landingClientEntry("03.", "Kuatro Group")
							@landingClientEntry("04.", "Chatsheet")
							@landingClientEntry("05.", "Candy")
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
						<h2 class="cobalt-section-title max-w-4xl">Selected work, in three entries.</h2>
						<p class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em]">Production systems / Current index</p>
					</div>
					if len(lp.FeaturedWorks) == 0 {
						<div class="border-b border-border py-10">
							<p class="text-sm">No featured work is published yet.</p>
						</div>
					} else {
						<div>
							for index, work := range lp.FeaturedWorks {
								{{ workData := newWorkData(work) }}
								@landingWorkRow(fmt.Sprintf("%02d.", index+1), workData)
							}
						</div>
					}
					<div class="flex justify-end pt-8">
						<a href={ routes.WorkIndex.URL() } class="inline-flex min-h-11 items-center border border-foreground px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View the complete work index</a>
					</div>
				</section>

				<section class="relative flex min-h-[72svh] items-center border-y border-foreground">
					<div class="container mx-auto px-6 py-24 md:px-8 md:py-28">
						<p class="text-xs font-semibold uppercase tracking-[0.18em]">The founder problem / 01</p>
						<blockquote class="cobalt-quote mt-10 max-w-6xl">&ldquo;We need someone senior who can take this from unclear product goal to shipped, maintainable software.&rdquo;</blockquote>
						<div class="mt-14 flex flex-col gap-3 border-t border-foreground pt-5 text-xs uppercase tracking-[0.14em] sm:flex-row sm:items-center sm:justify-between">
							<p class="font-semibold">The reason MBV Labs exists</p>
							<p class="font-mono opacity-70">AMBIGUITY → DELIVERY → OWNERSHIP</p>
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="grid gap-16 lg:grid-cols-[0.95fr_1.05fr] lg:gap-24">
						<div>
							<p class="text-xs font-semibold uppercase tracking-[0.18em]">Development philosophy</p>
							<h2 class="cobalt-section-title mt-6">Agent-first development for getting to the right answer faster.</h2>
							<p class="mt-7 max-w-lg text-base leading-7">AI is most valuable when it helps a senior engineer explore the problem space faster: more options, faster experiments, clearer tradeoffs, and quicker convergence on software that fits the business.</p>
						</div>
						<div class="grid sm:grid-cols-2">
							@landingPhilosophyItem("01.", "Use agents to explore better options", "The advantage is not producing more code faster. It is exploring more approaches, testing more assumptions, and comparing tradeoffs before committing to a path.")
							@landingPhilosophyItem("02.", "Stay hypothesis-driven", "Good software still starts with a clear hypothesis. Agents accelerate the loop, but the work remains grounded in product context, technical judgment, and evidence.")
							@landingPhilosophyItem("03.", "Iterate quickly without losing control", "AI can generate options, prototypes, tests, migrations, refactors, and implementation plans. The discipline is framing the problem, inspecting the output, and turning useful experiments into maintainable software.")
							@landingPhilosophyItem("04.", "Build systems teams can own", "The goal is not a pile of AI-generated code. The goal is finished software your team can understand, operate, and extend after the engagement ends.")
						</div>
					</div>
				</section>

				<section class="border-y border-foreground">
					<div class="container mx-auto px-6 py-20 md:px-8 md:py-24">
						<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
							<h2 class="cobalt-section-title max-w-4xl">Technical leadership, measured by shipped outcomes.</h2>
							<p class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em]">Services / Field report</p>
						</div>
						<div class="mt-12 grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-20">
							<div>
								<div class="cobalt-pixel-chart" aria-hidden="true">
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
									<div class="cobalt-pixel-bar"></div>
								</div>
								<div class="mt-3 flex justify-between font-mono text-[10px] tracking-[0.08em] md:text-xs">
									<span>UNCLEAR GOAL</span>
									<span>SHIPPED SYSTEM</span>
								</div>
							</div>
							<div>
								@landingServiceItem("01.", "Shape the technical plan", "Turn ambiguous business and product goals into a practical implementation path, with tradeoffs visible before work starts.")
								@landingServiceItem("02.", "Build production software", "Ship web apps, internal tools, automations, integrations, and backend systems using maintainable full-stack engineering.")
								@landingServiceItem("03.", "Improve existing systems", "Audit, modernize, refactor, or extend codebases so your team can move faster without compounding technical debt.")
								<a href={ routes.ServiceOfferingIndex.URL() } class="mt-8 inline-flex min-h-11 items-center border border-primary bg-primary px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Explore services</a>
							</div>
						</div>
					</div>
				</section>

				<section class="container mx-auto px-6 py-20 md:px-8 md:py-24">
					<div class="flex flex-col gap-5 border-b border-foreground pb-7 md:flex-row md:items-end md:justify-between">
						<h2 class="cobalt-section-title">Featured project ledger.</h2>
						<p class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em]">Independent builds / Selected</p>
					</div>
					if len(lp.FeaturedProjects) == 0 {
						<div class="border-b border-border py-10">
							<p class="text-sm">No featured projects are published yet.</p>
						</div>
					} else {
						<div>
							for index, project := range lp.FeaturedProjects {
								{{ projectData := newProjectData(project) }}
								@landingProjectRow(fmt.Sprintf("%02d.", index+1), projectData)
							}
						</div>
					}
					<div class="flex items-center justify-between gap-5 border-b border-foreground py-8 font-mono text-xs tracking-[0.08em]">
						<span>END OF LANDING REPORT</span>
						<span>MBV / 2026</span>
					</div>
				</section>
			</main>
		}
	}
}

templ landingClientEntry(index string, name string) {
	<div class="flex min-h-36 flex-col justify-between border-b border-border px-5 py-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
		<p class="font-mono text-xs tracking-[0.08em]">{ index }</p>
		<p class="font-heading text-2xl font-normal md:text-3xl">{ name }</p>
	</div>
}

templ landingWorkRow(index string, workData WorkData) {
	<a href={ routes.WorkShow.URL(workData.Slug) } class="group grid gap-6 border-b border-border py-12 transition-colors hover:bg-secondary/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring md:grid-cols-[4rem_minmax(0,0.72fr)_minmax(0,1.35fr)_7rem] md:items-start md:px-3">
		<p class="font-mono text-sm tracking-[0.08em]">{ index }</p>
		<div class="text-xs uppercase leading-5 tracking-[0.12em]">
			if workData.ClientName != "" {
				<p class="font-semibold">{ workData.ClientName }</p>
			}
			if !workData.CompletedAt.IsZero() {
				<p class="mt-1 opacity-65">{ workData.CompletedAt.Format("2006") }</p>
			}
		</div>
		<div>
			<h3 class="cobalt-row-title">{ workData.Title }</h3>
			<p class="mt-4 max-w-2xl text-sm leading-6">{ workData.Summary }</p>
		</div>
		<span class="text-xs font-semibold uppercase tracking-[0.12em] transition-transform group-hover:translate-x-1 md:text-right">Read case →</span>
	</a>
}

templ landingServiceItem(index string, title string, body string) {
	<div class="grid grid-cols-[4rem_1fr] gap-5 border-t border-border py-10 first:border-t-0 lg:first:border-t">
		<p class="font-mono text-sm tracking-[0.08em]">{ index }</p>
		<div>
			<h3 class="cobalt-row-title">{ title }</h3>
			<p class="mt-4 max-w-xl text-sm leading-6">{ body }</p>
		</div>
	</div>
}

templ landingPhilosophyItem(index string, title string, body string) {
	<div class="border-t border-border py-10 sm:px-8 sm:odd:border-r sm:odd:pl-0 sm:even:pr-0">
		<p class="font-mono text-sm tracking-[0.08em]">{ index }</p>
		<h3 class="cobalt-row-title mt-6">{ title }</h3>
		<p class="mt-4 text-sm leading-6">{ body }</p>
	</div>
}

templ landingProjectRow(index string, projectData ProjectData) {
	<a href={ routes.ProjectShow.URL(projectData.Slug) } class="group grid gap-6 border-b border-border py-12 transition-colors hover:bg-secondary/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring md:grid-cols-[4rem_minmax(0,0.72fr)_minmax(0,1.35fr)_7rem] md:items-start md:px-3">
		<p class="font-mono text-sm tracking-[0.08em]">{ index }</p>
		<div>
			<p class="text-xs font-semibold uppercase leading-5 tracking-[0.12em]">{ projectData.ProjectTypeLabel() }</p>
			<p class="mt-1 text-xs uppercase tracking-[0.12em] opacity-65">{ projectData.SourceLabel() }</p>
		</div>
		<div>
			<h3 class="cobalt-row-title">{ projectData.Name }</h3>
			<p class="mt-4 max-w-2xl text-sm leading-6">{ projectData.Tagline }</p>
		</div>
		<span class="text-xs font-semibold uppercase tracking-[0.12em] transition-transform group-hover:translate-x-1 md:text-right">View project →</span>
	</a>
}

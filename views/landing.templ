package views

import (
	"mbvlabs/models"
	"mbvlabs/router/routes"
)

type LandingPage struct {
	FeaturedWorks    []models.WorkEntity
	FeaturedProjects []models.ProjectEntity
}

func (lp LandingPage) PageFragment() string {
	return "landing-page-fragment"
}

templ (lp LandingPage) Page() {
	@base(
		SetTitle("Fractional Tech Lead"),
		SetDescription("MBV Labs helps founders and lean teams turn ambiguous software goals into shipped production systems."),
		SetSlug(routes.HomePage.URL()),
		SetSchema(HomePageSchema()),
	) {
		@templ.Fragment(lp.PageFragment()) {
			<main id="landing-page-fragment-container" class="overflow-hidden bg-white">
				<section class="relative">
					<div class="pointer-events-none absolute inset-0 opacity-70" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px), linear-gradient(0deg, rgba(24,24,27,0.035) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 pb-24 pt-20 md:pb-32 md:pt-24">
						<div class="max-w-2xl">
							<p class="text-xs font-bold text-zinc-950">MBV Labs</p>
							<h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-6xl">Fractional tech lead for founders who need software shipped.</h1>
							<p class="mt-6 max-w-xl text-sm leading-6 text-zinc-500">I help lean teams shape ambiguous product goals, make practical architecture decisions, and build production web apps, internal tools, automations, and developer infrastructure.</p>
							<div class="mt-8 flex flex-wrap gap-3">
								<a href={ routes.ProjectInquiryIndex.URL() } class="inline-flex bg-zinc-950 px-4 py-2 text-xs font-bold text-white transition-colors hover:bg-zinc-700">Start an inquiry</a>
								<a href={ routes.WorkIndex.URL() } class="inline-flex border border-zinc-200 px-4 py-2 text-xs font-bold text-zinc-950 transition-colors hover:border-zinc-950">View work</a>
							</div>
						</div>
					</div>
				</section>
				<section class="bg-zinc-950 text-white">
					<div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
						<div class="flex items-center gap-4">
							<h2 class="shrink-0 text-xs font-bold text-white">Trusted technical work</h2>
							<div class="h-px flex-1 bg-white/10"></div>
						</div>
						<div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-7 md:grid-cols-5">
							@landingClientLogoInvert("https://media.mbvlabs.com/clients/yld-logo.svg", "YLD")
							@landingClientLogo("https://media.mbvlabs.com/clients/everphone-gmbh-logo.jpeg", "everphone")
							@landingClientLogo("https://media.mbvlabs.com/clients/kuatro-group-logo.jpeg", "Kuatro Group")
							@landingClientLogo("https://media.mbvlabs.com/clients/chatsheet.png", "Chatsheet")
							@landingClientLogo("https://media.mbvlabs.com/clients/candy.jpg", "Candy")
						</div>
					</div>
				</section>
				<section class="mx-auto max-w-5xl px-6 py-20 md:py-28">
					<div class="max-w-2xl">
						<p class="text-xs font-bold text-zinc-950">Selected work</p>
						<h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-4xl">Production systems shaped by senior engineering judgment.</h2>
						<p class="mt-5 max-w-xl text-sm leading-6 text-zinc-500">Selected client work, production systems, and technical leadership examples from MBV Labs engagements.</p>
					</div>
					if len(lp.FeaturedWorks) == 0 {
						<div class="mt-10 border-t border-zinc-200 pt-8">
							<p class="text-sm text-zinc-500">No featured work is published yet.</p>
						</div>
					} else {
						<div class="mt-10 grid gap-5 md:grid-cols-3">
							for _, work := range lp.FeaturedWorks {
								{{ workData := newWorkData(work) }}
								@landingWorkCard(workData)
							}
						</div>
					}
				</section>
				<section class="relative bg-zinc-50">
					<div class="pointer-events-none absolute inset-0 opacity-60" style="background-image: linear-gradient(105deg, rgba(24,24,27,0.06) 1px, transparent 1px); background-size: 78px 78px; transform: skewY(-8deg); transform-origin: top left;"></div>
					<div class="relative mx-auto max-w-5xl px-6 py-20 md:py-24">
						<blockquote class="max-w-2xl text-2xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-3xl">
							&ldquo;We need someone senior who can take this from unclear product goal to shipped, maintainable software.&rdquo;
						</blockquote>
						<div class="mt-7 flex items-center gap-3">
							<span class="inline-flex h-6 w-6 items-center justify-center bg-zinc-950 text-[10px] font-bold text-white">M</span>
							<p class="text-xs font-bold uppercase text-zinc-950">founder problem MBV Labs is built for</p>
						</div>
					</div>
				</section>
				<section class="mx-auto max-w-5xl px-6 py-20 md:py-28">
					<div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
						<div>
							<p class="text-xs font-bold text-zinc-950">Development philosophy</p>
							<h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-4xl">Agent-first development for getting to the right answer faster.</h2>
							<p class="mt-5 max-w-sm text-sm leading-6 text-zinc-500">AI is most valuable when it helps a senior engineer explore the problem space faster: more options, faster experiments, clearer tradeoffs, and quicker convergence on software that fits the business.</p>
						</div>
						<div class="space-y-8">
							@landingPhilosophyItem("01", "Use agents to explore better options", "The advantage is not producing more code faster. It is exploring more approaches, testing more assumptions, and comparing tradeoffs before committing to a path.")
							@landingPhilosophyItem("02", "Stay hypothesis-driven", "Good software still starts with a clear hypothesis. Agents accelerate the loop, but the work remains grounded in product context, technical judgment, and evidence.")
							@landingPhilosophyItem("03", "Iterate quickly without losing control", "AI can generate options, prototypes, tests, migrations, refactors, and implementation plans. The discipline is framing the problem, inspecting the output, and turning useful experiments into maintainable software.")
							@landingPhilosophyItem("04", "Build systems teams can own", "The goal is not a pile of AI-generated code. The goal is finished software your team can understand, operate, and extend after the engagement ends.")
						</div>
					</div>
				</section>
				<section class="mx-auto max-w-5xl px-6 py-20 md:py-28">
					<div class="max-w-2xl">
						<p class="text-xs font-bold text-zinc-950">Services</p>
						<h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-zinc-950 md:text-4xl">Technical leadership and implementation for focused teams.</h2>
						<p class="mt-5 max-w-xl text-sm leading-6 text-zinc-500">The useful work is rarely just writing code. It is choosing what to build, reducing delivery risk, and leaving the system easier to operate after launch.</p>
					</div>
					<div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
						<div class="relative min-h-[360px] overflow-hidden bg-zinc-950 text-white">
							<div class="absolute inset-x-0 top-0 h-10 bg-zinc-800"></div>
							<div class="absolute left-8 right-8 top-20 space-y-4 font-mono text-[11px] leading-5 text-white/55">
								<p><span class="text-white">type</span> BuildPlan struct &#123;</p>
								<p class="pl-4">ProductGoal string</p>
								<p class="pl-4">Architecture []Decision</p>
								<p class="pl-4">DeliveryRisk []Tradeoff</p>
								<p class="pl-4">ShippedSoftware bool</p>
								<p>&#125;</p>
							</div>
							<div class="absolute bottom-8 left-8 right-8 border-t border-white/10 pt-5">
								<p class="max-w-sm text-sm font-semibold leading-6">Senior engineering work for product teams that need momentum without adding a full-time technical leader.</p>
							</div>
						</div>
						<div class="space-y-8">
							@landingServiceItem("01", "Shape the technical plan", "Turn ambiguous business and product goals into a practical implementation path, with tradeoffs visible before work starts.")
							@landingServiceItem("02", "Build production software", "Ship web apps, internal tools, automations, integrations, and backend systems using maintainable full-stack engineering.")
							@landingServiceItem("03", "Improve existing systems", "Audit, modernize, refactor, or extend codebases so your team can move faster without compounding technical debt.")
							<a href={ routes.ServiceOfferingIndex.URL() } class="inline-flex bg-zinc-950 px-4 py-2 text-xs font-bold text-white transition-colors hover:bg-zinc-700">Explore services</a>
						</div>
					</div>
				</section>
				<section class="mx-auto max-w-5xl px-6 pb-20 md:pb-28">
					<div class="flex items-center gap-4">
						<h2 class="shrink-0 text-base font-bold text-zinc-950">Featured projects</h2>
						<div class="h-px flex-1 bg-zinc-200"></div>
					</div>
					if len(lp.FeaturedProjects) == 0 {
						<div class="mt-8 border-t border-zinc-200 pt-8">
							<p class="text-sm text-zinc-500">No featured projects are published yet.</p>
						</div>
					} else {
						<div class="mt-8 grid gap-5 md:grid-cols-3">
							for _, project := range lp.FeaturedProjects {
								{{ projectData := newProjectData(project) }}
								@landingProjectCard(projectData)
							}
						</div>
					}
				</section>
			</main>
		}
	}
}

templ landingClientLogo(src string, alt string) {
	<div class="flex min-h-12 items-center">
		<img src={ src } alt={ alt } loading="lazy" decoding="async" class="max-h-8 w-auto max-w-32 object-contain grayscale opacity-80 transition-opacity hover:opacity-100"/>
	</div>
}

templ landingClientLogoInvert(src string, alt string) {
	<div class="flex min-h-12 items-center">
		<img src={ src } alt={ alt } loading="lazy" decoding="async" class="max-h-8 w-auto max-w-32 object-contain invert"/>
	</div>
}

templ landingWorkCard(workData WorkData) {
	<article class="border border-zinc-200 bg-white p-6">
		<div class="flex h-10 items-center">
			if workData.ClientLogoUrl != "" {
				<img src={ workData.ClientLogoUrl } alt={ workData.ClientName } class="max-h-9 w-auto object-contain"/>
			} else {
				<span class="inline-flex h-9 w-9 items-center justify-center bg-zinc-950 text-xs font-bold text-white">{ workData.Initial() }</span>
			}
		</div>
		<div class="mt-8 space-y-2 text-xs leading-5 text-zinc-500">
			if !workData.CompletedAt.IsZero() {
				<p>{ workData.CompletedAt.Format("2006") }</p>
			}
			if workData.ClientName != "" {
				<p class="font-bold text-zinc-950">{ workData.ClientName }</p>
			}
		</div>
		<h3 class="mt-5 text-xl font-semibold leading-tight tracking-tight text-zinc-950">{ workData.Title }</h3>
		<p class="mt-4 text-sm leading-6 text-zinc-500">{ workData.Summary }</p>
		<a href={ routes.WorkShow.URL(workData.Slug) } class="mt-6 inline-flex text-xs font-bold text-zinc-950 transition-colors hover:text-zinc-500">Read case study</a>
	</article>
}

templ landingServiceItem(index string, title string, body string) {
	<div class="border-t border-zinc-200 pt-6">
		<p class="text-xs font-bold text-zinc-400">{ index }</p>
		<h3 class="mt-3 text-base font-bold text-zinc-950">{ title }</h3>
		<p class="mt-3 max-w-md text-sm leading-6 text-zinc-500">{ body }</p>
	</div>
}

templ landingPhilosophyItem(index string, title string, body string) {
	<div class="border-t border-zinc-200 pt-6">
		<p class="text-xs font-bold text-zinc-400">{ index }</p>
		<h3 class="mt-3 text-xl font-semibold leading-tight tracking-tight text-zinc-950">{ title }</h3>
		<p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-500">{ body }</p>
	</div>
}

templ landingProjectCard(projectData ProjectData) {
	<article class="border-t border-zinc-200 py-8">
		<div class="flex h-10 items-center">
			if projectData.ImageURL != "" {
				<img src={ projectData.ImageURL } alt={ projectData.Name } class="max-h-9 w-auto object-contain"/>
			} else {
				<span class="inline-flex h-9 w-9 items-center justify-center bg-zinc-950 text-xs font-bold text-white">{ projectData.Initial() }</span>
			}
		</div>
		<p class="mt-6 text-xs font-bold text-zinc-400">{ projectData.ProjectTypeLabel() } / { projectData.SourceLabel() }</p>
		<h3 class="mt-3 text-xl font-semibold leading-tight tracking-tight text-zinc-950">{ projectData.Name }</h3>
		<p class="mt-4 text-sm leading-6 text-zinc-500">{ projectData.Tagline }</p>
		<a href={ routes.ProjectShow.URL(projectData.Slug) } class="mt-6 inline-flex text-xs font-bold text-zinc-950 transition-colors hover:text-zinc-500">View project</a>
	</article>
}
